{
  "permissions": {
    "allow": [
      "Bash(python3 -m json.tool)",
      "Bash(pm2 logs *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cloud-cost-gate.sh",
            "timeout": 10,
            "statusMessage": "Cloud cost gate"
          }
        ]
      }
    ]
  }
}
