# Environment variables for Docker deployment
# Copy this to .env and update with your secure values

# Application Settings
NODE_ENV=production
PORT=8000
CORS_ORIGIN=https://mayden.in

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=mediczy_ai
POSTGRES_USER=mediczy_helper
POSTGRES_PASSWORD=change-this-helper-password
POSTGRES_POOL_MAX=10
POSTGRES_POOL_MIN=0
POSTGRES_SSL=false
POSTGRES_URI=
CITUS_ENABLED=false
# Comma-separated host:port worker list, e.g.
# CITUS_WORKERS=pg-worker-1:5432,pg-worker-2:5432
CITUS_WORKERS=
PGVECTOR_ENABLED=true
PGVECTOR_DIMENSION=1536
PGVECTOR_DISTANCE=cosine
PGVECTOR_IVFFLAT_LISTS=100
VECTOR_NAMESPACE=default
VECTOR_STORE_TYPE=pgvector
EMBEDDING_CACHE_TTL=86400
REDIS_URL=redis://:secure-redis-password-change-this@redis:6379

# Security Keys (CHANGE THESE!)
SESSION_SECRET=your-super-secret-session-key-at-least-32-characters-long
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long
ENCRYPTION_KEY=your-encryption-key-32-characters-long
ALLOW_DEV_TOKENS=false
ALLOW_TENANT_HEADER=false
ALLOW_TENANT_FALLBACK=false
ALLOW_LEGACY_LOCATION_FALLBACK=false

# External Services
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@mediczy.com

# AI/ML Services (Optional)
OPENAI_API_KEY=your-openai-api-key-if-using-ai-features
GEMINI_API_KEY=your-google-ai-key-if-using-gemini

# File Upload Settings
MAX_FILE_SIZE=50MB
UPLOAD_PATH=/app/uploads

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_METRICS=true

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Video Calling
TURN_SERVER_URL=stun:stun.l.google.com:19302
TURN_USERNAME=
TURN_CREDENTIAL=

# Payment Gateway (if using)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
