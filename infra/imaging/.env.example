# Copy to infra/imaging/.env — never commit real secrets.
#
# Escape `$` as `$$` in Compose .env files.
ORTHANC_USER=pacs
ORTHANC_PASSWORD=replace-me-with-a-strong-secret
ORTHANC_REGISTERED_USERS={"pacs":"replace-me-with-a-strong-secret"}
# echo -n 'pacs:replace-me-with-a-strong-secret' | base64
ORTHANC_BASIC_AUTH=REPLACE_WITH_BASE64_OF_user_colon_password
MEDICZY_API_URL=http://host.docker.internal:8888
