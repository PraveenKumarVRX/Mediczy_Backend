# MediQzy imaging reverse proxy
# /ohif/* → OHIF Viewer
# /pacs/* → Orthanc HTTP API + DICOMweb (auth_request validates pacs_session cookie)
#
# ORTHANC_BASIC_AUTH must be the base64 of "user:password" (no "Basic " prefix).
# Official nginx image envsubst fills this from /etc/nginx/templates/.

upstream ohif_upstream {
  server ohif:80;
}

upstream orthanc_upstream {
  server orthanc:8042;
}

server {
  listen 80;
  server_name _;

  client_max_body_size 512m;

  location /ohif/ {
    proxy_pass http://ohif_upstream/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /pacs/ {
    auth_request /_pacs_auth;
    auth_request_set $auth_status $upstream_status;

    proxy_pass http://orthanc_upstream/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Inject Orthanc credentials server-side (never exposed to browser)
    proxy_set_header Authorization "Basic ${ORTHANC_BASIC_AUTH}";
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  location = /_pacs_auth {
    internal;
    proxy_pass http://host.docker.internal:8888/api/imaging/session/validate;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Original-URI $request_uri;
  }

  location /health {
    return 200 'ok';
    add_header Content-Type text/plain;
  }
}
