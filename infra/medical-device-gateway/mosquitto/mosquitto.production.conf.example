# Production additions for a hospital deployment. Paths are mounted secrets;
# never commit keys, passwords, or issued certificates to this repository.
include_dir /mosquitto/config/conf.d
listener 8883
cafile /run/secrets/device_ca.pem
certfile /run/secrets/broker_cert.pem
keyfile /run/secrets/broker_key.pem
require_certificate true
use_identity_as_username true
allow_anonymous false
persistence true
persistence_location /mosquitto/data/
acl_file /mosquitto/config/aclfile
message_size_limit 262144
