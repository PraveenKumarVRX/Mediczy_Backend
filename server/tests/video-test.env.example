# Copy this file to /etc/mediczy/video-test.env and set real credentials.
# chmod 600 /etc/mediczy/video-test.env

VIDEO_TEST_PATIENT_EMAIL=user@mediczy.com
VIDEO_TEST_PATIENT_PASSWORD=User@123
VIDEO_TEST_DOCTOR_EMAIL=doctor@mediczy.com
VIDEO_TEST_DOCTOR_PASSWORD=Doctor123

# Optional: webhook for failure alerts
# VIDEO_TEST_ALERT_WEBHOOK=https://hooks.slack.com/services/XXXX/XXXX/XXXX

# Optional: explicit cloud endpoint override if needed by downstream scripts
# LIVEKIT_URL=wss://msh-kw9tvxa9.livekit.cloud
# LIVEKIT_API_URL=https://msh-kw9tvxa9.livekit.cloud
