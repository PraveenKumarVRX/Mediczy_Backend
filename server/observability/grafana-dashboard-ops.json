{
  "schemaVersion": 38,
  "title": "Mediczy Ops Overview",
  "timezone": "browser",
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "API RPS",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(http_requests_total[1m]))", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "API 5xx Rate",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(http_requests_total{status_code=~'5..'}[5m]))", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "API p95 Latency (s)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "API p99 Latency (s)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API RPS by Route",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum by (route) (rate(http_requests_total[1m]))", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "API Errors by Route",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum by (route) (rate(http_requests_total{status_code=~'5..'}[5m]))", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "PM2 CPU by Process",
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 6},
      "targets": [
        {"expr": "pm2_cpu", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "PM2 Memory by Process (bytes)",
      "gridPos": {"x": 12, "y": 10, "w": 12, "h": 6},
      "targets": [
        {"expr": "pm2_memory", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "PM2 Restarts (per 10m)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 6},
      "targets": [
        {"expr": "increase(pm2_restarts[10m])", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "PM2 Event Loop Delay",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 6},
      "targets": [
        {"expr": "pm2_loop_delay", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "Probe Success",
      "gridPos": {"x": 0, "y": 22, "w": 6, "h": 4},
      "targets": [
        {"expr": "probe_success", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Probe Duration (s)",
      "gridPos": {"x": 6, "y": 22, "w": 18, "h": 4},
      "targets": [
        {"expr": "probe_duration_seconds", "refId": "A"}
      ]
    }
  ],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"}
}
