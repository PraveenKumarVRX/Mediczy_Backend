# ==================== APPLICATION CONFIGURATION ====================
NODE_ENV=development
PORT=5000

# ==================== SECURITY - JWT TOKEN ====================
# CRITICAL: Generate a strong random secret key (minimum 256 bits / 32 bytes)
# Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER commit the actual secret to version control!
SECRET_TOKEN=your_super_secure_random_secret_key_here_CHANGE_THIS_IMMEDIATELY

# ==================== ENCRYPTION ====================
# CRITICAL: Field-level encryption for PHI/PII data at rest (HIPAA/GDPR/DPDP)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be 64 hex characters (32 bytes) for AES-256 encryption
ENCRYPTION_KEY=your_encryption_key_64_hex_chars_here_CHANGE_THIS_IMMEDIATELY

# ==================== CORS CONFIGURATION ====================
# Comma-separated list of allowed origins (no spaces)
# Production example: https://mayden.in,https://www.mayden.in
# Development default: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== DATABASE - POSTGRESQL ====================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=mediczy_ai
POSTGRES_USER=mediczy_helper
POSTGRES_PASSWORD=StrongHelperPass123!
POSTGRES_POOL_MAX=10
POSTGRES_POOL_MIN=0
POSTGRES_SSL=false
POSTGRES_URI=
CITUS_ENABLED=false
CITUS_WORKERS=
PGVECTOR_ENABLED=true
PGVECTOR_DIMENSION=1536
PGVECTOR_DISTANCE=cosine
PGVECTOR_IVFFLAT_LISTS=100
VECTOR_NAMESPACE=default
VECTOR_STORE_TYPE=pgvector
EMBEDDING_CACHE_TTL=86400

# ==================== REDIS CONFIGURATION ====================
# Used for caching, session management, and async job queues
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== KAFKA CONFIGURATION ====================
# Used for event streaming and async processing
KAFKA_ENABLED=false
KAFKA_CLIENT_ID=mediczy-server
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=mediczy-consumers

# ==================== EXTERNAL SERVICES ====================

# Ayushman Bharat Integration (NHA - National Health Authority)
AYUSHMAN_API_URL=https://abdm-api.ndhm.gov.in
AYUSHMAN_CLIENT_ID=your_ayushman_client_id
AYUSHMAN_CLIENT_SECRET=your_ayushman_client_secret

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# Google Fit API (Health Data Integration)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/fitness/callback

# AI Services
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# SIB (Synthetic Intelligence Brain) Configuration
SIB_URL=http://localhost:8001
# CRITICAL: Admin token for kill switch deactivation
# Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SIB_ADMIN_TOKEN=your_sib_admin_token_CHANGE_THIS_IMMEDIATELY

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# SMS Gateway (Twilio or similar)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==================== VIDEO PROVIDERS ====================

# LiveKit (self-hosted)
LIVEKIT_URL=wss://livekit.your-domain.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_MEET_URL=https://meet.your-domain.com

# ==================== LOGGING & MONITORING ====================
LOG_LEVEL=info
SENTRY_DSN=

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ==================== FILE UPLOAD ====================
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# ==================== LEGACY (MongoDB helper no longer used) ====================
# MONGO_URI=

# ==================== COMPLIANCE & DATA RETENTION ====================
# Data retention periods (in days)
AUDIT_LOG_RETENTION_DAYS=2190  # 6 years (HIPAA requirement)
DELETED_ACCOUNT_RETENTION_DAYS=2190  # 6 years
EXPIRED_CONSENT_RETENTION_DAYS=730  # 2 years
INACTIVE_USER_THRESHOLD_DAYS=1095  # 3 years

# Session timeout (milliseconds)
SESSION_TIMEOUT_MS=900000  # 15 minutes (HIPAA best practice)
MAX_SESSION_LIFETIME_MS=86400000  # 24 hours

# ==================== SECURITY NOTES ====================
# 1. NEVER commit actual secrets to git
# 2. Generate SECRET_TOKEN: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 3. Generate ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. Rotate secrets every 90 days
# 5. Use different secrets for dev/staging/production
# 6. Review ALLOWED_ORIGINS - never use wildcards in production
# 7. Store ENCRYPTION_KEY in secure key management service (AWS KMS, Azure Key Vault)
# 8. Enable database encryption at rest in production
# 9. Use HTTPS/TLS in production (configure reverse proxy)
# 10. Regular security audits and penetration testing recommended
# ==================== EMAIL CONFIGURATION - SMTP ==========================
# Email settings for sending OTP codes, notifications, etc.
# Recommended providers: Gmail, SendGrid, AWS SES, Mailgun

# SMTP Host (e.g., smtp.gmail.com for Gmail, smtp.sendgrid.net for SendGrid)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587

# SMTP Security (true for TLS/STARTTLS, false for SSL or unencrypted)
SMTP_SECURE=false

# SMTP Username (usually your email address)
SMTP_USER=your-email@example.com

# SMTP Password (app password for Gmail, API key for SendGrid)
SMTP_PASS=your-smtp-password-or-app-password

# Sender Email and Name
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Mediczy Health Platform

# ==================== SMS CONFIGURATION - TWILIO ==========================
# Twilio SMS for sending OTP codes via text message
# Get credentials from: https://console.twilio.com/
# See SMS_CONFIGURATION.md for detailed setup instructions

# Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token (secret authentication token)
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here

# Twilio Phone Number (must include country code, e.g., +12025551234)
TWILIO_PHONE_NUMBER=+12025551234

# ==================== WHATSAPP CONFIGURATION - TWILIO ==========================
# WhatsApp Business API for sending OTP codes via WhatsApp
# Get credentials from: https://console.twilio.com/
# See WHATSAPP_CONFIGURATION.md for detailed setup instructions

# Twilio WhatsApp Number (format: whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# WhatsApp Message Template SID (for approved templates)
WHATSAPP_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== PASSWORD RESET CONFIGURATION ==========================
# OTP Configuration for password reset

# OTP Length (recommended: 6)
OTP_LENGTH=6

# OTP Expiration in minutes (recommended: 10)
OTP_EXPIRY_MINUTES=10

# Reset Token Expiration in minutes (recommended: 60)
RESET_TOKEN_EXPIRY_MINUTES=60

# ==================== RATE LIMITING FOR PASSWORD RESET ==========================
# Prevent abuse of password reset and other sensitive endpoints

# Maximum OTP requests per user per hour
MAX_OTP_REQUESTS_PER_HOUR=5

# Maximum OTP verification attempts
MAX_OTP_ATTEMPTS=5

# ==================== DEVELOPMENT / DEBUG ==========================
# Development-only settings

# Enable detailed logging (true/false)
DEBUG_MODE=false

# Display OTP codes in console (ONLY FOR DEVELOPMENT - set to false in production)
SHOW_OTP_IN_CONSOLE=false

# Bypass email/SMS sending (ONLY FOR DEVELOPMENT)
BYPASS_MESSAGING=false
