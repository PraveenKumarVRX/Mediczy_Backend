# Environment variables for Docker deployment
# Copy this to .env and update with your secure values

# Application Settings
NODE_ENV=production
PORT=8000
CORS_ORIGIN=https://mayden.in

# SIB → Node.js internal service-to-service auth (used by Python SIB task_router)
MEDICZY_API_URL=http://localhost:8000
MEDICZY_INTERNAL_TOKEN=change-this-internal-service-token

# Offline Scribe service auth (shared secret between Node.js and Python scribe)
SCRIBE_API_URL=http://localhost:8006
SCRIBE_PORT=8006
SCRIBE_TOKEN=change-this-scribe-token
SCRIBE_CORS_ORIGINS=http://localhost:8888,https://app.mediqzy.com

# n8n workflow automation (REQUIRED — never commit the real key)
N8N_ENCRYPTION_KEY=change-this-n8n-encryption-key

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=mediczy_ai
POSTGRES_USER=mediczy_helper
POSTGRES_PASSWORD=change-this-helper-password
POSTGRES_POOL_MAX=50
POSTGRES_POOL_MIN=5
POSTGRES_POOL_IDLE=10000
POSTGRES_POOL_ACQUIRE=30000
POSTGRES_SSL=false
POSTGRES_URI=
# PgBouncer — point app here instead of directly at RDS in production
PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=6432
USE_PGBOUNCER=false
# pgvector — dimension MUST match embedding model (768=LaBSE/MiniLM, 1536=OpenAI ada-002)
PGVECTOR_ENABLED=true
PGVECTOR_DIMENSION=768
PGVECTOR_DISTANCE=cosine
PGVECTOR_INDEX_TYPE=hnsw
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
VECTOR_NAMESPACE=default
VECTOR_STORE_TYPE=pgvector
EMBEDDING_CACHE_TTL=86400
REDIS_URL=redis://:secure-redis-password-change-this@redis:6379

# Security Keys (CHANGE THESE!)
SESSION_SECRET=your-super-secret-session-key-at-least-32-characters-long
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long
# Optional dedicated AES-256 key for encrypting TOTP secrets. If omitted, the
# JWT secret is used as a derived key; production should set this separately.
MFA_ENCRYPTION_KEY=replace-with-a-dedicated-strong-secret
ENCRYPTION_KEY=your-encryption-key-32-characters-long
# Dedicated AES-256-GCM key for tenant CRM channel credentials (64 hex chars).
CRM_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-dedicated-64-hex-character-key

# Dev token bypass — only effective in NODE_ENV=development|test AND when set to "true".
# NEVER set to "true" in production.
ALLOW_DEV_TOKENS=false

# Membership renewal exemption — comma-separated emails that bypass plan expiry checks.
# Used for internal test accounts. Leave empty in production.
MEMBERSHIP_RENEWAL_EXEMPT_EMAILS=

# Password reset — set to "true" to block inactive accounts from requesting OTP resets.
PASSWORD_RESET_BLOCK_INACTIVE_ACCOUNTS=false

# Token security — max active refresh tokens per user per device fingerprint (0 = unlimited).
MAX_REFRESH_TOKENS_PER_DEVICE=5

ALLOW_TENANT_HEADER=false
ALLOW_TENANT_FALLBACK=false
ALLOW_LEGACY_LOCATION_FALLBACK=false

# External Services
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@mediczy.com

# Aggregator (Mayden) API Credentials
MAYDEN_AGGREGATOR_BASE_URL=https://app.mediqzy.com/api
MAYDEN_AGGREGATOR_CLIENT_ID=your-mayden-client-id
MAYDEN_AGGREGATOR_CLIENT_SECRET=your-mayden-client-secret

# AI/ML Services (Optional)
OPENAI_API_KEY=your-openai-api-key-if-using-ai-features

# Sarvam AI — Indic/multilingual fallback provider in the LLM cascade (after SIB + Groq).
# Inert unless SARVAM_ENABLED=true AND SARVAM_API_KEY is set. In prod the key lives in SSM
# (/mediczy/prod/SARVAM_API_KEY); keep SARVAM_ENABLED=false until UAT clears it.
SARVAM_ENABLED=false
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
# SARVAM_URL=https://api.sarvam.ai
# SARVAM_TIMEOUT_MS=20000

OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_FALLBACK_MODELS=tts-1
GEMINI_API_KEY=your-google-ai-key-if-using-gemini

# AI Scribe Service
SCRIBE_API_URL=http://localhost:8005

# File Upload Settings
MAX_FILE_SIZE=50MB
UPLOAD_PATH=/app/uploads

# NestJS (strangler-fig — runs alongside Express during migration)
NESTJS_PORT=8001
AGENT_RUN_TIMEOUT_MS=30000

# Kafka (set KAFKA_ENABLED=true when MSK is provisioned)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=mediczy-app
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_PARTITIONS=3
KAFKA_REPLICATION=2

# Redis mode: single | sentinel | cluster
REDIS_MODE=single
REDIS_SENTINELS=localhost:26379
REDIS_SENTINEL_MASTER=mymaster
REDIS_CLUSTER_NODES=localhost:7000

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_METRICS=true

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Clean-room MedCore capability adoption kill-switch. Set false until clinical/counsel sign-off.
MEDCORE_ADOPTION_ENABLED=false

# Video Calling
LIVEKIT_URL=wss://msh-kw9tvxa9.livekit.cloud
LIVEKIT_API_URL=https://msh-kw9tvxa9.livekit.cloud
LIVEKIT_MEET_URL=https://msh-kw9tvxa9.livekit.cloud
LIVEKIT_API_KEY=your-livekit-cloud-api-key
LIVEKIT_API_SECRET=your-livekit-cloud-api-secret
TURN_SERVER_URL=stun:stun.l.google.com:19302
TURN_USERNAME=
TURN_CREDENTIAL=

# Payment Gateway (if using)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Facebook / Instagram Lead Ads + Meta CAPI
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=
FB_PIXEL_ID=
FB_CAPI_ACCESS_TOKEN=
FB_CAPI_TEST_EVENT_CODE=
FB_GRAPH_API_VERSION=v19.0
N8N_WEBHOOK_URL=http://localhost:5678/webhook/fb-lead-intake
FB_TEST_LEADS_ALLOWED=false

# CRM lead automation
CRM_SALES_WHATSAPP=+917826911911
CRM_HOT_LEAD_THRESHOLD=70
CRM_HOT_LEAD_ASSIGN_USER_ID=
CRM_MARKETING_LIST_ID=
CRM_FB_MARKETING_LIST_ID=
CRM_WEB_MARKETING_LIST_ID=
CRM_BASE_URL=https://mediqzy.com
# Agentic CRM and growth workspaces are enabled in the production rollout.
# Access remains protected by CRM authentication and capability-based RBAC.
CRM_AGENT_ENABLED=true
CRM_FLOW_BUILDER_ENABLED=true
CRM_SOCIAL_GROWTH_ENABLED=true

# ─── Insurance Desk: NHCX (National Health Claims Exchange) ────────────────
# Government FHIR claims-exchange gateway. Setting these turns on real
# eligibility/pre-auth/claim submission via server/services/nhcx-client.service.js
# — until then, calls return an honest "not configured" result, never fabricated
# data. Formal NHCX certification (Level 1/2) with the NHA is a separate
# business/compliance process — see the Insurance Desk RAG analysis.
NHCX_CLIENT_ID=
NHCX_CLIENT_SECRET=
NHCX_ENDPOINT=https://nhcx.abdm.gov.in/api/v1

# ─── Insurance Desk: Insurer eligibility clients ────────────────────────────
# server/services/insurance-provider.service.js — falls back to mock data
# per-insurer when its key is unset.
STAR_HEALTH_API_KEY=
HDFC_ERGO_API_KEY=
ICICI_LOMBARD_API_KEY=
BAJAJ_ALLIANZ_API_KEY=

# ─── Insurance Desk: TPA connectors (17) ────────────────────────────────────
# server/services/*-tpa.service.js — each connector is real, working code;
# it only needs the partner-issued credentials below to go live. Check
# GET /api/hospital/insurance/tpa/readiness for which are currently configured.
HERITAGE_TPA_AUTH_ID=
MDINDIA_TPA_USERNAME=
MDINDIA_TPA_PASSWORD=
HEALTHINDIA_TPA_AUTH_TOKEN=
HEALTHINDIA_TPA_CLIENT_ID=
CARE_TPA_PARTNER_ID=
CARE_TPA_PARTNER_KEY=
FGI_TPA_CLIENT_ID=
FGI_TPA_CLIENT_SECRET=
FGI_TPA_API_KEY=
GODIGIT_TPA_CLIENT_ID=
GODIGIT_TPA_CLIENT_SECRET=
ICICI_TPA_USERNAME=
ICICI_TPA_PASSWORD=
MEDIASSIST_TPA_CLIENT_ID=
MEDIASSIST_TPA_USERNAME=
MEDIASSIST_TPA_PASSWORD=
STARHEALTH_TPA_USERNAME=
STARHEALTH_TPA_PASSWORD=
STARHEALTH_TPA_PARTNER_ID=
FHPL_TPA_USERNAME=
FHPL_TPA_PASSWORD=
FHPL_TPA_CLIENT_ID=
MEDSAVE_TPA_CLIENT_ID=
MEDSAVE_TPA_SECRET=
MEDSAVE_TPA_API_KEY=
NIVABUPA_TPA_USERNAME=
NIVABUPA_TPA_PASSWORD=
NIVABUPA_TPA_API_KEY=
PARAMOUNT_TPA_USERNAME=
PARAMOUNT_TPA_PASSWORD=
PARAMOUNT_TPA_CLIENT_ID=
RAKSHA_TPA_API_KEY=
RAKSHA_TPA_SECRET=
VIDAL_TPA_CLIENT_ID=
VIDAL_TPA_SECRET=
VIDAL_TPA_API_KEY=
VOLO_TPA_USERNAME=
VOLO_TPA_PASSWORD=
VOLO_TPA_PARTNER_ID=
EWAT_TPA_API_KEY=
EWAT_TPA_PARTNER_ID=

# Corporate management: allow promoting an existing employee account to HR admin
# (overwrites users.role and password on that account). Keep OFF until the
# one-account / two-context HR design lands. Default: off.
ENABLE_EMPLOYEE_TO_HR_PROMOTION=false

# Mediczy keeps channel delivery; Chatwoot hosts tenant human-agent workspaces.
CHATWOOT_ENABLED=false
CHATWOOT_URL=https://chat.mediqzy.com
# These values belong only in the deployment secret store/server environment.
CHATWOOT_MEDSTAR_API_TOKEN=
CHATWOOT_MEDSTAR_WEBHOOK_SECRET=
CHATWOOT_MEDSTAR_WHATSAPP_ACCOUNT_SID=
CHATWOOT_MEDSTAR_WHATSAPP_AUTH_TOKEN=

# Primary WhatsApp transport. Keep twilio until Gupshup credentials/webhook are ready.
WHATSAPP_PROVIDER=twilio
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=918098998998
# Protect /api/whatsapp-production/webhook/gupshup with either or both:
# 1. >=32-char secret supplied in x-gupshup-webhook-secret by a verified ingress proxy;
# 2. exact public provider IPs obtained from Gupshup support (comma-separated, no CIDRs).
# A proxy must validate the provider before injecting the secret. Never accept a public arbitrary header bypass.
GUPSHUP_WEBHOOK_SECRET=
GUPSHUP_WEBHOOK_ALLOWED_IPS=
# Gupshup approved template IDs, NOT Twilio HX content SIDs. Missing IDs block business sends.
GUPSHUP_TEMPLATE_OTP=
GUPSHUP_TEMPLATE_APPOINTMENT_CONFIRMATION=
GUPSHUP_TEMPLATE_APPOINTMENT_REMINDER=
GUPSHUP_TEMPLATE_HEALTH_CHECKUP=
GUPSHUP_TEMPLATE_HEALTH_REPORT=
GUPSHUP_TEMPLATE_PRESCRIPTION=
GUPSHUP_TEMPLATE_CHECKUP_REMINDER=
GUPSHUP_TEMPLATE_MEMBERSHIP_RENEWAL_REMINDER=
GUPSHUP_TEMPLATE_MEMBERSHIP_RENEWAL_PAYMENT=
GUPSHUP_TEMPLATE_MEMBERSHIP_PLAN_ACTIVATED=
GUPSHUP_TEMPLATE_KIOSK_REGISTER=

# Antivirus (ClamAV daemon). Scanner errors reject the upload with 503 unless
# AV_SCAN_FAIL_OPEN=true (emergency-only override). Requires clamav-daemon running;
# clamdscan is invoked with --fdpass.
AV_SCAN_ENABLED=true
AV_SCAN_FAIL_OPEN=false

# GPU scheduling (opt-in). Per-GPU concurrency limits, priority queue and a circuit breaker
# around iSHA node calls; needs migrations/20261008000100-ai-gpu-scheduler-log.sql for history.
AI_GPU_SCHEDULER_ENABLED=false
# GPU3090_MAX_CONCURRENCY=3
# GPU3060_MAX_CONCURRENCY=8
# GPU3090_TIMEOUT_MS=45000
# GPU3060_TIMEOUT_MS=20000

# Clinical medical-device gateway. The legacy embedded broker remains disabled
# unless a time-bounded migration explicitly opts in. Production MQTT must use
# mutual TLS and a secret manager rather than these password placeholders.
ENABLE_LEGACY_EMBEDDED_MQTT=false
ENABLE_MEDICAL_DEVICE_MQTT_INGEST=false
MEDICAL_DEVICE_MQTT_URL=
MEDICAL_DEVICE_MQTT_CLIENT_ID=
MEDICAL_DEVICE_MQTT_USERNAME=
MEDICAL_DEVICE_MQTT_PASSWORD=

# Signed Node -> SIB requests. Use the same >=32-character secret in both services.
# Production startup fetches SIB_SERVICE_SECRET from SSM; JWT_SECRET is the compatibility fallback.
SIB_SERVICE_SECRET=
# Only clinically evaluated languages should be enabled.
CHATBOT_SUPPORTED_LANGUAGES=en
CHATBOT_PROMPT_VERSION=unapproved
CHATBOT_TASK_MUTATIONS_ENABLED=false
CHATBOT_PERSONAL_CONTEXT_ENABLED=false
