# ==============================================
# MEDICZY PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ==============================================
# SECURITY - REQUIRED
# ==============================================
# Generate strong secrets: openssl rand -base64 48
JWT_SECRET=your-strong-jwt-secret-min-32-chars-CHANGE-THIS
ENCRYPTION_KEY=your-strong-encryption-key-min-32-chars-CHANGE-THIS

# ==============================================
# DATABASE - POSTGRESQL - REQUIRED
# ==============================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=mediczy_ai
POSTGRES_USER=mediczy_helper
POSTGRES_PASSWORD=your-strong-helper-password-CHANGE-THIS
POSTGRES_POOL_MAX=10
POSTGRES_POOL_MIN=0
POSTGRES_SSL=false
POSTGRES_URI=

# ==============================================
# CACHE - REDIS - REQUIRED
# ==============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================
# NODE ENVIRONMENT - REQUIRED
# ==============================================
NODE_ENV=production

# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=8000
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ==============================================
# ADDITIONAL DATABASES (OPTIONAL)
# ==============================================
DUCKDB_PATH=./data/mediczy.duckdb
VECTOR_DB_URL=http://localhost:8001
INTELLIGENT_DB_URL=http://localhost:5005

# ==============================================
# INTEGRATIONS (OPTIONAL)
# ==============================================
GROQ_API_KEY=your-groq-api-key-if-using-ai-features
ADMIN_EMAIL=admin@yourdomain.com

# ==============================================
# FEATURE FLAGS (OPTIONAL)
# ==============================================
DISABLE_KAFKA=false

# ==============================================
# EMAIL CONFIGURATION (OPTIONAL)
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ==============================================
# VIDEO PROVIDERS (OPTIONAL)
# ==============================================

# LiveKit (self-hosted)
LIVEKIT_URL=wss://livekit.yourdomain.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_MEET_URL=https://meet.yourdomain.com

# ==============================================
# FRONTEND URL (OPTIONAL)
# ==============================================
FRONTEND_URL=https://yourdomain.com

# ==============================================
# MONITORING & LOGGING (OPTIONAL)
# ==============================================
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# ==============================================
# INSURANCE DESK: NHCX, INSURER & TPA CREDENTIALS (OPTIONAL)
# ==============================================
# Full list with descriptions: server/.env.example. Every value here turns a
# real, already-coded integration on — nothing is fabricated when unset.
NHCX_CLIENT_ID=
NHCX_CLIENT_SECRET=
NHCX_ENDPOINT=https://nhcx.abdm.gov.in/api/v1
STAR_HEALTH_API_KEY=
HDFC_ERGO_API_KEY=
ICICI_LOMBARD_API_KEY=
BAJAJ_ALLIANZ_API_KEY=
HERITAGE_TPA_AUTH_ID=
MDINDIA_TPA_USERNAME=
MDINDIA_TPA_PASSWORD=
HEALTHINDIA_TPA_AUTH_TOKEN=
HEALTHINDIA_TPA_CLIENT_ID=
CARE_TPA_PARTNER_ID=
CARE_TPA_PARTNER_KEY=
FGI_TPA_CLIENT_ID=
FGI_TPA_CLIENT_SECRET=
FGI_TPA_API_KEY=
GODIGIT_TPA_CLIENT_ID=
GODIGIT_TPA_CLIENT_SECRET=
ICICI_TPA_USERNAME=
ICICI_TPA_PASSWORD=
MEDIASSIST_TPA_CLIENT_ID=
MEDIASSIST_TPA_USERNAME=
MEDIASSIST_TPA_PASSWORD=
STARHEALTH_TPA_USERNAME=
STARHEALTH_TPA_PASSWORD=
STARHEALTH_TPA_PARTNER_ID=
FHPL_TPA_USERNAME=
FHPL_TPA_PASSWORD=
FHPL_TPA_CLIENT_ID=
MEDSAVE_TPA_CLIENT_ID=
MEDSAVE_TPA_SECRET=
MEDSAVE_TPA_API_KEY=
NIVABUPA_TPA_USERNAME=
NIVABUPA_TPA_PASSWORD=
NIVABUPA_TPA_API_KEY=
PARAMOUNT_TPA_USERNAME=
PARAMOUNT_TPA_PASSWORD=
PARAMOUNT_TPA_CLIENT_ID=
RAKSHA_TPA_API_KEY=
RAKSHA_TPA_SECRET=
VIDAL_TPA_CLIENT_ID=
VIDAL_TPA_SECRET=
VIDAL_TPA_API_KEY=
VOLO_TPA_USERNAME=
VOLO_TPA_PASSWORD=
VOLO_TPA_PARTNER_ID=
EWAT_TPA_API_KEY=
EWAT_TPA_PARTNER_ID=
