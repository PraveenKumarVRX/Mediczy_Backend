/**
 * Webhooks Routes - Mediqzy API v1 (MVC Refactored)
 * Created: February 6, 2026
 * Updated: February 6, 2026 - Refactored to MVC pattern
 * 
 * Endpoints:
 * - POST /v1/{tenant-id}/webhooks - Register webhook
 * - GET /v1/{tenant-id}/webhooks - List webhooks
 * - GET /v1/{tenant-id}/webhooks/:webhookId - Webhook details
 * - PUT /v1/{tenant-id}/webhooks/:webhookId - Update webhook
 * - DELETE /v1/{tenant-id}/webhooks/:webhookId - Delete webhook
 * - POST /v1/{tenant-id}/webhooks/:webhookId/test - Test webhook
 * - GET /v1/{tenant-id}/webhooks/:webhookId/deliveries - Delivery history
 */

import express from 'express';
import { verifyToken, verifyTenant, requireScopes } from '../middleware/api-auth.js';
import { webhooksValidation, handleValidationErrors } from '../middleware/validation.js';
import * as webhooksController from '../controllers/api-v1/WebhooksController.js';

const router = express.Router();

// Apply authentication and tenant verification to all routes
router.use(verifyToken, verifyTenant);

/**
 * POST /v1/{tenant-id}/webhooks
 * Register a new webhook
 */
router.post('/', verifyToken, verifyTenant, requireScopes('webhooks.write'), async (req, res) => {
  try {
    const { tenantId, user } = req;
    const { url, events, description, secret } = req.body;

    if (!url || !events || events.length === 0) {
      return res.status(400).json({
        error: {
          code: 'INVALID_REQUEST',
          message: 'url and events are required'
        }
      });
    }

    // Validate URL format
    try {
      new URL(url);
    } catch {
      return res.status(400).json({
        error: {
          code: 'INVALID_URL',
          message: 'Invalid webhook URL format'
        }
      });
    }

    // Generate signing secret if not provided
    const signingSecret = secret || crypto.randomBytes(32).toString('hex');

    const result = await pool.query(
      `INSERT INTO api_webhooks 
       (tenant_id, url, events, description, secret, status, created_by)
       VALUES ($1, $2, $3, $4, $5, 'active', $6)
       RETURNING *`,
      [tenantId, url, JSON.stringify(events), description, signingSecret, user.user_id]
    );

    await logAudit({
      tenant_id: tenantId,
      user_id: user.user_id,
      action: 'webhook.created',
      resource_type: 'webhook',
      resource_id: result.rows[0].webhook_id.toString()
    });

    res.status(201).json(formatWebhookResponse(result.rows[0]));

  } catch (error) {
    console.error('Webhook registration error:', error);
    res.status(500).json({
      error: {
        code: 'WEBHOOK_REGISTRATION_FAILED',
        message: 'Failed to register webhook'
      }
    });
  }
});

/**
 * GET /v1/{tenant-id}/webhooks
 * List webhooks
 */
router.get('/', verifyToken, verifyTenant, requireScopes('webhooks.read'), async (req, res) => {
  try {
    const { tenantId } = req;
    const { status, limit = 20, offset = 0 } = req.query;

    let query = 'SELECT * FROM api_webhooks WHERE tenant_id = $1';
    const params = [tenantId];
    let paramCount = 1;

    if (status) {
      paramCount++;
      query += ` AND status = $${paramCount}`;
      params.push(status);
    }

    query += ' ORDER BY created_at DESC';
    paramCount++;
    query += ` LIMIT $${paramCount}`;
    params.push(parseInt(limit));
    paramCount++;
    query += ` OFFSET $${paramCount}`;
    params.push(parseInt(offset));

    const result = await pool.query(query, params);

    res.status(200).json({
      webhooks: result.rows.map(formatWebhookResponse),
      pagination: { limit: parseInt(limit), offset: parseInt(offset) }
    });

  } catch (error) {
    console.error('Webhooks fetch error:', error);
    res.status(500).json({
      error: {
        code: 'WEBHOOKS_FETCH_FAILED',
        message: 'Failed to fetch webhooks'
      }
    });
  }
});

/**
 * GET /v1/{tenant-id}/webhooks/{webhook_id}
 * Get webhook details
 */
router.get('/:webhook_id', verifyToken, verifyTenant, requireScopes('webhooks.read'), async (req, res) => {
  try {
    const { tenantId } = req;
    const { webhook_id } = req.params;

    const result = await pool.query(
      'SELECT * FROM api_webhooks WHERE tenant_id = $1 AND webhook_id = $2',
      [tenantId, parseInt(webhook_id)]
    );

    if (result.rows.length === 0) {
      return res.status(404).json({
        error: {
          code: 'WEBHOOK_NOT_FOUND',
          message: 'Webhook not found'
        }
      });
    }

    res.status(200).json(formatWebhookResponse(result.rows[0]));

  } catch (error) {
    console.error('Webhook fetch error:', error);
    res.status(500).json({
      error: {
        code: 'WEBHOOK_FETCH_FAILED',
        message: 'Failed to fetch webhook'
      }
    });
  }
});

/**
 * PUT /v1/{tenant-id}/webhooks/{webhook_id}
 * Update webhook
 */
router.put('/:webhook_id', verifyToken, verifyTenant, requireScopes('webhooks.write'), async (req, res) => {
  try {
    const { tenantId, user } = req;
    const { webhook_id } = req.params;
    const { url, events, description, status } = req.body;

    // Build dynamic update
    const updates = [];
    const params = [tenantId, parseInt(webhook_id)];
    let paramCount = 2;

    if (url) {
      // Validate URL
      try {
        new URL(url);
      } catch {
        return res.status(400).json({
          error: {
            code: 'INVALID_URL',
            message: 'Invalid webhook URL format'
          }
        });
      }
      paramCount++;
      updates.push(`url = $${paramCount}`);
      params.push(url);
    }

    if (events) {
      paramCount++;
      updates.push(`events = $${paramCount}`);
      params.push(JSON.stringify(events));
    }

    if (description !== undefined) {
      paramCount++;
      updates.push(`description = $${paramCount}`);
      params.push(description);
    }

    if (status) {
      paramCount++;
      updates.push(`status = $${paramCount}`);
      params.push(status);
    }

    if (updates.length === 0) {
      return res.status(400).json({
        error: {
          code: 'INVALID_REQUEST',
          message: 'No fields to update'
        }
      });
    }

    const query = `UPDATE api_webhooks SET ${updates.join(', ')}
                   WHERE tenant_id = $1 AND webhook_id = $2
                   RETURNING *`;

    const result = await pool.query(query, params);

    if (result.rows.length === 0) {
      return res.status(404).json({
        error: {
          code: 'WEBHOOK_NOT_FOUND',
          message: 'Webhook not found'
        }
      });
    }

    await logAudit({
      tenant_id: tenantId,
      user_id: user.user_id,
      action: 'webhook.updated',
      resource_type: 'webhook',
      resource_id: webhook_id
    });

    res.status(200).json(formatWebhookResponse(result.rows[0]));

  } catch (error) {
    console.error('Webhook update error:', error);
    res.status(500).json({
      error: {
        code: 'WEBHOOK_UPDATE_FAILED',
        message: 'Failed to update webhook'
      }
    });
  }
});

/**
 * DELETE /v1/{tenant-id}/webhooks/{webhook_id}
 * Delete webhook
 */
router.delete('/:webhook_id', verifyToken, verifyTenant, requireScopes('webhooks.write'), async (req, res) => {
  try {
    const { tenantId, user } = req;
    const { webhook_id } = req.params;

    const result = await pool.query(
      'DELETE FROM api_webhooks WHERE tenant_id = $1 AND webhook_id = $2 RETURNING webhook_id',
      [tenantId, parseInt(webhook_id)]
    );

    if (result.rows.length === 0) {
      return res.status(404).json({
        error: {
          code: 'WEBHOOK_NOT_FOUND',
          message: 'Webhook not found'
        }
      });
    }

    await logAudit({
      tenant_id: tenantId,
      user_id: user.user_id,
      action: 'webhook.deleted',
      resource_type: 'webhook',
      resource_id: webhook_id
    });

    res.status(200).json({
      webhook_id: parseInt(webhook_id),
      deleted: true
    });

  } catch (error) {
    console.error('Webhook deletion error:', error);
    res.status(500).json({
      error: {
        code: 'WEBHOOK_DELETION_FAILED',
        message: 'Failed to delete webhook'
      }
    });
  }
});

/**
 * GET /v1/{tenant-id}/webhooks/{webhook_id}/deliveries
 * Get webhook delivery history
 */
router.get('/:webhook_id/deliveries', verifyToken, verifyTenant, requireScopes('webhooks.read'), async (req, res) => {
  try {
    const { tenantId } = req;
    const { webhook_id } = req.params;
    const { status, limit = 50, offset = 0 } = req.query;

    let query = 'SELECT * FROM api_webhook_deliveries WHERE tenant_id = $1 AND webhook_id = $2';
    const params = [tenantId, parseInt(webhook_id)];
    let paramCount = 2;

    if (status) {
      paramCount++;
      query += ` AND status = $${paramCount}`;
      params.push(status);
    }

    query += ' ORDER BY created_at DESC';
    paramCount++;
    query += ` LIMIT $${paramCount}`;
    params.push(parseInt(limit));
    paramCount++;
    query += ` OFFSET $${paramCount}`;
    params.push(parseInt(offset));

    const result = await pool.query(query, params);

    res.status(200).json({
      deliveries: result.rows.map(formatDeliveryResponse),
      pagination: { limit: parseInt(limit), offset: parseInt(offset) }
    });

  } catch (error) {
    console.error('Webhook deliveries fetch error:', error);
    res.status(500).json({
      error: {
        code: 'DELIVERIES_FETCH_FAILED',
        message: 'Failed to fetch webhook deliveries'
      }
    });
  }
});

/**
 * POST /v1/{tenant-id}/webhooks/{webhook_id}/test
 * Test webhook delivery
 */
router.post('/:webhook_id/test', verifyToken, verifyTenant, requireScopes('webhooks.write'), async (req, res) => {
  try {
    const { tenantId, user } = req;
    const { webhook_id } = req.params;

    // Get webhook details
    const webhookResult = await pool.query(
      'SELECT * FROM api_webhooks WHERE tenant_id = $1 AND webhook_id = $2',
      [tenantId, parseInt(webhook_id)]
    );

    if (webhookResult.rows.length === 0) {
      return res.status(404).json({
        error: {
          code: 'WEBHOOK_NOT_FOUND',
          message: 'Webhook not found'
        }
      });
    }

    const webhook = webhookResult.rows[0];

    // Create test payload
    const testPayload = {
      event: 'webhook.test',
      tenant_id: tenantId,
      timestamp: new Date().toISOString(),
      data: {
        message: 'This is a test webhook delivery',
        webhook_id: parseInt(webhook_id)
      }
    };

    // Generate HMAC signature
    const signature = generateWebhookSignature(testPayload, webhook.secret);

    // Attempt delivery (simplified - would use queue in production)
    let deliveryStatus = 'pending';
    let responseStatus = null;
    let responseBody = null;

    try {
      const response = await fetch(webhook.url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Mediqzy-Signature': signature,
          'X-Mediqzy-Event': testPayload.event
        },
        body: JSON.stringify(testPayload)
      });

      responseStatus = response.status;
      responseBody = await response.text();
      deliveryStatus = response.ok ? 'delivered' : 'failed';

    } catch (error) {
      deliveryStatus = 'failed';
      responseBody = error.message;
    }

    // Log delivery
    const deliveryResult = await pool.query(
      `INSERT INTO api_webhook_deliveries 
       (tenant_id, webhook_id, event, payload, status, response_status, 
        response_body, delivered_at)
       VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
       RETURNING *`,
      [
        tenantId,
        parseInt(webhook_id),
        testPayload.event,
        JSON.stringify(testPayload),
        deliveryStatus,
        responseStatus,
        responseBody,
        deliveryStatus === 'delivered' ? new Date() : null
      ]
    );

    res.status(200).json({
      test_delivery: formatDeliveryResponse(deliveryResult.rows[0]),
      message: 'Test webhook sent'
    });

  } catch (error) {
    console.error('Webhook test error:', error);
    res.status(500).json({
      error: {
        code: 'WEBHOOK_TEST_FAILED',
        message: 'Failed to test webhook'
      }
    });
  }
});

/**
 * Helper: Generate HMAC signature for webhook payload
 */
function generateWebhookSignature(payload, secret) {
  const hmac = crypto.createHmac('sha256', secret);
  hmac.update(JSON.stringify(payload));
  return `sha256=${hmac.digest('hex')}`;
}

/**
 * Helper: Format webhook response
 */
function formatWebhookResponse(webhook) {
  return {
    webhook_id: webhook.webhook_id,
    url: webhook.url,
    events: webhook.events,
    description: webhook.description,
    secret: webhook.secret, // In production, only show this once during creation
    status: webhook.status,
    last_delivery_at: webhook.last_delivery_at,
    created_by: webhook.created_by,
    created_at: webhook.created_at,
    updated_at: webhook.updated_at
  };
}

/**
 * Helper: Format delivery response
 */
function formatDeliveryResponse(delivery) {
  return {
    delivery_id: delivery.delivery_id,
    webhook_id: delivery.webhook_id,
    event: delivery.event,
    payload: delivery.payload,
    status: delivery.status,
    response_status: delivery.response_status,
    response_body: delivery.response_body,
    attempt_count: delivery.attempt_count,
    delivered_at: delivery.delivered_at,
    created_at: delivery.created_at
  };
}

export default router;
