/**
 * Doctor Search Routes - Mediqzy API v1
 * Created: February 6, 2026
 * 
 * Endpoints:
 * - GET /v1/{tenant-id}/doctors - Search doctors
 * - GET /v1/{tenant-id}/doctors/{doctor_id} - Get doctor details
 * - GET /v1/{tenant-id}/doctors/{doctor_id}/availability - Get doctor availability
 * - GET /v1/{tenant-id}/doctors/{doctor_id}/slots - Get available time slots
 */

import express from 'express';
import { verifyToken, verifyTenant, requireScopes } from '../middleware/api-auth.js';
import pg from 'pg';
const { Pool } = pg;

const router = express.Router();

const pool = new Pool({
  host: process.env.DB_HOST || 'localhost',
  port: process.env.DB_PORT || 5432,
  database: process.env.DB_NAME || 'mediczy_ai',
  user: process.env.DB_USER || 'mediczy_helper',
  password: process.env.DB_PASSWORD,
});

/**
 * GET /v1/{tenant-id}/doctors
 * Search doctors with filters
 */
router.get('/', verifyToken, verifyTenant, requireScopes('doctors.read'), async (req, res) => {
  try {
    const { tenantId } = req;
    const {
      specialty,
      city,
      consultation_type, // online, offline, both
      min_rating,
      language,
      available_date,
      sort_by = 'rating', // rating, experience, fee
      order = 'desc',
      limit = 20,
      offset = 0
    } = req.query;

    let query = 'SELECT * FROM api_doctors WHERE tenant_id = $1';
    const params = [tenantId];
    let paramCount = 1;

    // Apply filters
    if (specialty) {
      paramCount++;
      query += ` AND specialty = $${paramCount}`;
      params.push(specialty);
    }

    if (city) {
      paramCount++;
      query += ` AND city = $${paramCount}`;
      params.push(city);
    }

    if (min_rating) {
      paramCount++;
      query += ` AND rating >= $${paramCount}`;
      params.push(parseFloat(min_rating));
    }

    if (consultation_type && consultation_type !== 'both') {
      paramCount++;
      query += ` AND consultation_types @> $${paramCount}::jsonb`;
      params.push(JSON.stringify([consultation_type]));
    }

    if (language) {
      paramCount++;
      query += ` AND languages @> $${paramCount}::jsonb`;
      params.push(JSON.stringify([language]));
    }

    // Sorting
    const validSortFields = {
      rating: 'rating',
      experience: 'experience_years',
      fee: 'consultation_fee'
    };
    const sortField = validSortFields[sort_by] || 'rating';
    const sortOrder = order === 'asc' ? 'ASC' : 'DESC';
    query += ` ORDER BY ${sortField} ${sortOrder}`;

    // Pagination
    paramCount++;
    query += ` LIMIT $${paramCount}`;
    params.push(parseInt(limit));
    
    paramCount++;
    query += ` OFFSET $${paramCount}`;
    params.push(parseInt(offset));

    const result = await pool.query(query, params);

    // Get total count
    const countQuery = 'SELECT COUNT(*) FROM api_doctors WHERE tenant_id = $1';
    const countResult = await pool.query(countQuery, [tenantId]);
    const totalDoctors = parseInt(countResult.rows[0].count);

    res.status(200).json({
      doctors: result.rows.map(formatDoctorResponse),
      pagination: {
        total: totalDoctors,
        limit: parseInt(limit),
        offset: parseInt(offset),
        has_more: (parseInt(offset) + parseInt(limit)) < totalDoctors
      }
    });

  } catch (error) {
    console.error('Doctor search error:', error);
    res.status(500).json({
      error: {
        code: 'SEARCH_FAILED',
        message: 'Failed to search doctors'
      }
    });
  }
});

/**
 * GET /v1/{tenant-id}/doctors/{doctor_id}
 * Get doctor details
 */
router.get('/:doctor_id', verifyToken, verifyTenant, requireScopes('doctors.read'), async (req, res) => {
  try {
    const { tenantId } = req;
    const { doctor_id } = req.params;

    const result = await pool.query(
      'SELECT * FROM api_doctors WHERE tenant_id = $1 AND doctor_id = $2',
      [tenantId, doctor_id]
    );

    if (result.rows.length === 0) {
      return res.status(404).json({
        error: {
          code: 'DOCTOR_NOT_FOUND',
          message: 'Doctor not found'
        }
      });
    }

    res.status(200).json(formatDoctorResponse(result.rows[0]));

  } catch (error) {
    console.error('Doctor fetch error:', error);
    res.status(500).json({
      error: {
        code: 'DOCTOR_FETCH_FAILED',
        message: 'Failed to fetch doctor details'
      }
    });
  }
});

/**
 * GET /v1/{tenant-id}/doctors/{doctor_id}/availability
 * Get doctor availability
 */
router.get('/:doctor_id/availability', verifyToken, verifyTenant, requireScopes('doctors.read'), async (req, res) => {
  try {
    const { tenantId } = req;
    const { doctor_id } = req.params;
    const { start_date, end_date } = req.query;

    // Get doctor
    const doctorResult = await pool.query(
      'SELECT working_hours FROM api_doctors WHERE tenant_id = $1 AND doctor_id = $2',
      [tenantId, doctor_id]
    );

    if (doctorResult.rows.length === 0) {
      return res.status(404).json({
        error: {
          code: 'DOCTOR_NOT_FOUND',
          message: 'Doctor not found'
        }
      });
    }

    const workingHours = doctorResult.rows[0].working_hours || {};

    res.status(200).json({
      doctor_id,
      working_hours: workingHours,
      timezone: 'Asia/Kolkata'
    });

  } catch (error) {
    console.error('Availability fetch error:', error);
    res.status(500).json({
      error: {
        code: 'AVAILABILITY_FETCH_FAILED',
        message: 'Failed to fetch availability'
      }
    });
  }
});

/**
 * GET /v1/{tenant-id}/doctors/{doctor_id}/slots
 * Get available time slots
 */
router.get('/:doctor_id/slots', verifyToken, verifyTenant, requireScopes('doctors.read'), async (req, res) => {
  try {
    const { tenantId } = req;
    const { doctor_id } = req.params;
    const { date, consultation_type = 'online' } = req.query;

    if (!date) {
      return res.status(400).json({
        error: {
          code: 'INVALID_REQUEST',
          message: 'date parameter is required (YYYY-MM-DD)'
        }
      });
    }

    // Get doctor working hours
    const doctorResult = await pool.query(
      'SELECT working_hours, slot_duration FROM api_doctors WHERE tenant_id = $1 AND doctor_id = $2',
      [tenantId, doctor_id]
    );

    if (doctorResult.rows.length === 0) {
      return res.status(404).json({
        error: {
          code: 'DOCTOR_NOT_FOUND',
          message: 'Doctor not found'
        }
      });
    }

    const { working_hours, slot_duration = 30 } = doctorResult.rows[0];

    // Get existing appointments for the date
    const appointmentsResult = await pool.query(
      `SELECT appointment_time, slot_duration FROM api_appointments
       WHERE tenant_id = $1 AND doctor_id = $2 AND appointment_date = $3
       AND status NOT IN ('cancelled', 'completed')`,
      [tenantId, doctor_id, date]
    );

    const bookedSlots = appointmentsResult.rows.map(row => row.appointment_time);

    // Generate slots based on working hours
    const dayOfWeek = new Date(date).toLocaleDateString('en-US', { weekday: 'lowercase' });
    const daySchedule = working_hours[dayOfWeek];

    if (!daySchedule || !daySchedule.available) {
      return res.status(200).json({
        doctor_id,
        date,
        slots: []
      });
    }

    const slots = generateTimeSlots(daySchedule.start, daySchedule.end, slot_duration, bookedSlots);

    res.status(200).json({
      doctor_id,
      date,
      consultation_type,
      slot_duration,
      slots
    });

  } catch (error) {
    console.error('Slots fetch error:', error);
    res.status(500).json({
      error: {
        code: 'SLOTS_FETCH_FAILED',
        message: 'Failed to fetch available slots'
      }
    });
  }
});

/**
 * Helper: Format doctor response
 */
function formatDoctorResponse(doctor) {
  return {
    doctor_id: doctor.doctor_id,
    name: doctor.name,
    specialty: doctor.specialty,
    qualification: doctor.qualification,
    experience_years: doctor.experience_years,
    rating: doctor.rating,
    consultation_fee: doctor.consultation_fee,
    languages: doctor.languages,
    consultation_types: doctor.consultation_types,
    profile_picture: doctor.profile_picture,
    city: doctor.city,
    clinic_name: doctor.clinic_name,
    working_hours: doctor.working_hours,
    bio: doctor.bio
  };
}

/**
 * Helper: Generate time slots
 */
function generateTimeSlots(startTime, endTime, duration, bookedSlots) {
  const slots = [];
  let current = parseTime(startTime);
  const end = parseTime(endTime);

  while (current < end) {
    const timeString = formatTime(current);
    const isAvailable = !bookedSlots.includes(timeString);
    
    slots.push({
      time: timeString,
      available: isAvailable
    });

    current += duration;
  }

  return slots;
}

function parseTime(timeString) {
  const [hours, minutes] = timeString.split(':').map(Number);
  return hours * 60 + minutes;
}

function formatTime(minutes) {
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  return `${String(hours).padStart(2, '0')}:${String(mins).padStart(2, '0')}`;
}

export default router;
