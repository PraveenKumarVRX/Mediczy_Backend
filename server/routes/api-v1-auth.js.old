/**
 * Authentication & Authorization Routes - Mediqzy API v1
 * Created: February 6, 2026
 * 
 * Endpoints:
 * - POST /v1/auth/exchange - Exchange external token
 * - POST /v1/auth/refresh - Refresh access token
 * - POST /v1/auth/revoke - Revoke token
 */

import express from 'express';
import { TokenExchangeService, verifyToken } from '../middleware/api-auth.js';
import pg from 'pg';
const { Pool } = pg;

const router = express.Router();

const pool = new Pool({
  host: process.env.DB_HOST || 'localhost',
  port: process.env.DB_PORT || 5432,
  database: process.env.DB_NAME || 'mediczy_ai',
  user: process.env.DB_USER || 'mediczy_helper',
  password: process.env.DB_PASSWORD,
});

/**
 * POST /v1/auth/exchange
 * Exchange external OIDC token for Mediqzy access token
 */
router.post('/exchange', async (req, res) => {
  try {
    const {
      provider_token,
      provider,
      external_user_id,
      role = 'patient',
      tenant_id
    } = req.body;

    // Validation
    if (!provider_token || !provider || !tenant_id) {
      return res.status(400).json({
        error: {
          code: 'INVALID_REQUEST',
          message: 'provider_token, provider, and tenant_id are required'
        }
      });
    }

    // Validate external token
    const externalUser = await TokenExchangeService.validateExternalToken(
      provider_token,
      provider
    );

    // Find or create user
    const user = await TokenExchangeService.findOrCreateUser(
      externalUser,
      tenant_id,
      role
    );

    // Define scopes based on role
    const scopes = getScopesForRole(role);

    // Generate Mediqzy tokens
    const tokens = TokenExchangeService.generateTokens(user, tenant_id, scopes);

    res.status(200).json({
      access_token: tokens.access_token,
      refresh_token: tokens.refresh_token,
      token_type: tokens.token_type,
      expires_in: tokens.expires_in,
      user_id: user.user_id,
      tenant_id: tenant_id,
      scopes: scopes
    });

  } catch (error) {
    console.error('Token exchange error:', error);
    res.status(400).json({
      error: {
        code: 'TOKEN_EXCHANGE_FAILED',
        message: error.message || 'Failed to exchange token'
      }
    });
  }
});

/**
 * POST /v1/auth/refresh
 * Refresh access token using refresh token
 */
router.post('/refresh', async (req, res) => {
  try {
    const { refresh_token } = req.body;

    if (!refresh_token) {
      return res.status(400).json({
        error: {
          code: 'INVALID_REQUEST',
          message: 'refresh_token is required'
        }
      });
    }

    // Refresh token
    const tokens = await TokenExchangeService.refreshAccessToken(refresh_token);

    res.status(200).json(tokens);

  } catch (error) {
    console.error('Token refresh error:', error);
    res.status(401).json({
      error: {
        code: 'REFRESH_FAILED',
        message: error.message || 'Failed to refresh token'
      }
    });
  }
});

/**
 * POST /v1/auth/revoke
 * Revoke access token (logout)
 */
router.post('/revoke', verifyToken, async (req, res) => {
  try {
    const { token } = req.body;

    // In production: maintain revoked tokens list (Redis)
    // For now, just acknowledge
    
    res.status(200).json({
      revoked: true,
      message: 'Token revoked successfully'
    });

  } catch (error) {
    console.error('Token revocation error:', error);
    res.status(500).json({
      error: {
        code: 'REVOCATION_FAILED',
        message: 'Failed to revoke token'
      }
    });
  }
});

/**
 * Helper: Get scopes based on user role
 */
function getScopesForRole(role) {
  const roleScopes = {
    patient: [
      'appointments.read',
      'appointments.write',
      'consultations.video',
      'consultations.chat',
      'pharmacy.read',
      'lab.read',
      'wellness.read'
    ],
    doctor: [
      'appointments.*',
      'consultations.*',
      'prescriptions.*',
      'chat.*'
    ],
    clinic_admin: [
      'appointments.*',
      'users.read',
      'doctors.*',
      'reports.read'
    ],
    corporate_admin: [
      'employees.*',
      'wellness.*',
      'hra.*',
      'reports.*'
    ],
    insurance_admin: [
      'policies.*',
      'claims.*',
      'users.read'
    ],
    tpa_admin: [
      'claims.*',
      'approvals.*',
      'reports.*'
    ]
  };

  return roleScopes[role] || roleScopes.patient;
}

export default router;
