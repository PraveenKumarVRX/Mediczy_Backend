# ===========================================
# MEDIQZY STAGING ENVIRONMENT
# Copy this file to .env.staging and update values
# ===========================================

NODE_ENV=staging
PORT=8000

# ===========================================
# DATABASE (Staging)
# ===========================================
DATABASE_URL=postgresql://mediqzy_staging:CHANGE_THIS_PASSWORD@localhost:5432/mediqzy_staging
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediqzy_staging
DB_USER=mediqzy_staging
DB_PASSWORD=CHANGE_THIS_PASSWORD

# ===========================================
# REDIS (Staging)
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ===========================================
# JWT SECRETS (Generate unique secrets for staging!)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ===========================================
JWT_SECRET=GENERATE_NEW_SECRET_FOR_STAGING
JWT_REFRESH_SECRET=GENERATE_NEW_REFRESH_SECRET_FOR_STAGING
JWT_EXPIRES_IN=30d

# ===========================================
# DOMAINS (Staging)
# ===========================================
FRONTEND_URL=https://staging.mediqzy.com
BACKEND_URL=https://staging.mediqzy.com
CORS_ORIGINS=https://staging.mediqzy.com,http://localhost:3000,http://localhost:5173

# ===========================================
# LIVEKIT VIDEO
# Can share with production or use separate staging instance
# ===========================================
LIVEKIT_HOST=video.mediqzy.com
LIVEKIT_URL=wss://video.mediqzy.com
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# ===========================================
# PAYMENT GATEWAY (USE TEST KEYS!)
# Get test keys from Razorpay dashboard
# ===========================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_TEST_WEBHOOK_SECRET

# ===========================================
# EMAIL SERVICE
# ===========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=staging@mediqzy.com
SMTP_PASS=YOUR_STAGING_EMAIL_PASSWORD
EMAIL_FROM="Mediqzy Staging <staging@mediqzy.com>"

# Brevo/SendinBlue (if using)
BREVO_API_KEY=YOUR_BREVO_API_KEY

# ===========================================
# SMS SERVICE
# ===========================================
SMS_API_KEY=YOUR_SMS_API_KEY
SMS_SENDER_ID=MEDQZY
SMS_TEST_MODE=true

# ===========================================
# FIREBASE (Create separate staging project!)
# ===========================================
FIREBASE_PROJECT_ID=mediqzy-staging
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@mediqzy-staging.iam.gserviceaccount.com

# ===========================================
# GOOGLE FIT (if using)
# ===========================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=combined

# ===========================================
# FEATURE FLAGS (Staging)
# Enable extra debugging for staging
# ===========================================
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_TEST_ACCOUNTS=true
MOCK_PAYMENTS=false
ENABLE_SWAGGER=true

# ===========================================
# KAFKA (if using in staging)
# ===========================================
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=mediqzy-staging

# ===========================================
# N8N WORKFLOW (if using)
# ===========================================
N8N_HOST=http://localhost:5678
N8N_API_KEY=YOUR_N8N_API_KEY

# ===========================================
# RATE LIMITING (Relaxed for staging)
# ===========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# ===========================================
# SESSION
# ===========================================
SESSION_SECRET=GENERATE_SESSION_SECRET_FOR_STAGING
