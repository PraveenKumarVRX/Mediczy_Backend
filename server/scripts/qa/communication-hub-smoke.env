# Smoke-only overrides for Communication Hub live API tests.
# Loaded after .env.production.local when present; safe to commit (no production secrets).

NODE_ENV=development
DOTENV_IN_PROD=true
DISABLE_KAFKA=true
DUCKDB_ENABLED=false
PGVECTOR_ENABLED=false
PGVECTOR_DIMENSION=768

PORT=18998
SMOKE_API_BASE=http://127.0.0.1:18998

# 64-char hex test key (smoke environments only)
ENCRYPTION_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456
JWT_SECRET=communication-hub-smoke-jwt-secret-32chars-min

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=mediczy_smoke
POSTGRES_USER=mediczy_smoke
POSTGRES_PASSWORD=mediczy_smoke_pw
POSTGRES_PRIMARY_HOST=127.0.0.1
POSTGRES_PRIMARY_PORT=5432
POSTGRES_PRIMARY_DATABASE=mediczy_smoke
POSTGRES_PRIMARY_USER=mediczy_smoke
POSTGRES_PRIMARY_PASSWORD=mediczy_smoke_pw

TEAM_SMOKE_EMAIL=smoke-team@mediczy.local
TEAM_SMOKE_PASSWORD=SmokeTest123!
SMOKE_USER_ID=9001
SMOKE_CORP_ID=1
