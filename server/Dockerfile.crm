FROM node:22-bookworm-slim
WORKDIR /app/server
ENV NODE_ENV=production PUPPETEER_SKIP_DOWNLOAD=true NODE_OPTIONS=--max-old-space-size=2048
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --legacy-peer-deps --no-audit --no-fund && npm cache clean --force
COPY server/ .
COPY shared/ /app/shared/
USER node
CMD ["node", "crm-app.mjs"]
