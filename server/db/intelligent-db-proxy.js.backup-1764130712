                dateOfBirth: data.dateOfBirth || new Date('1990-01-01'),
                gender: data.gender || 'Other',
                phoneNumber: data.phoneNumber || '',
              });
              await doc.save();
            }
          }
          // DuckDB fallback: append into a generic analytics log table
          await connectDuckDB();
          await executeDuckDB(`CREATE TABLE IF NOT EXISTS node_fallback_events(
            id BIGINT,
            collection VARCHAR,
            created_at TIMESTAMP,
            payload TEXT
          )`);
          await executeDuckDB(`INSERT INTO node_fallback_events VALUES (?, ?, NOW(), ?)`, [
            Date.now(),
            collection,
            JSON.stringify(data)
          ]);
          return { success: true, fallback: true };
        }
      } catch (fallbackErr) {
        console.error('❌ Fallback store failed:', fallbackErr.message);
      }
      return { success: false, error: error.message };
    }
  }

