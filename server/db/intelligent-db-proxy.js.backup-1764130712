  // ========================================================================
  // REPLICATION TO HELPER DATABASES
  // ========================================================================

  async _replicateToHelpers(collection, data) {
    const results = { mongo: false, duckdb: false };
    
    // Replicate to MongoDB
    try {
      const { connectMongoDB } = await import('./mongo.js');
      const { mongoose } = await import('./mongo.js');
      await connectMongoDB();
      
      // Map collection name to Mongoose model
      const modelMap = {
        'users': 'User',
        'doctors': 'Doctor',
        'appointments': 'Appointment'
      };
      
      const modelName = modelMap[collection];
      if (modelName) {
        const Model = mongoose.models[modelName] || (await import(`../models/${collection.slice(0, -1)}.model.js`)).default;
        
        // Convert MariaDB data to MongoDB format
        const mongoData = { ...data };
        if (mongoData.id && !mongoData._id) {
          delete mongoData.id; // Let MongoDB generate _id
        }
        
        await Model.findOneAndUpdate(
          { email: data.email }, // Match by email
          mongoData,
          { upsert: true, new: true }
        );
        results.mongo = true;
        console.log(`✅ Replicated to MongoDB: ${collection}/${data.email || data.id}`);
      }
    } catch (error) {
      console.warn(`⚠️  MongoDB replication failed for ${collection}:`, error.message);
    }
    
    // Replicate to DuckDB analytics
    try {
      await connectDuckDB();
      
      // Log to analytics table
      const tableName = `${collection}_analytics`;
      const timestamp = new Date().toISOString();
      const jsonData = JSON.stringify(data);
      
      await executeDuckDB(`
        CREATE TABLE IF NOT EXISTS ${tableName} (
          id VARCHAR PRIMARY KEY,
          data JSON,
          replicated_at TIMESTAMP,
          source VARCHAR DEFAULT 'mariadb'
        )
      `);
      
      await executeDuckDB(`
        INSERT OR REPLACE INTO ${tableName} (id, data, replicated_at, source)
        VALUES (?, ?, ?, 'mariadb')
      `, [data.id || data.email || Date.now().toString(), jsonData, timestamp]);
      
      results.duckdb = true;
      console.log(`✅ Replicated to DuckDB: ${tableName}/${data.email || data.id}`);
    } catch (error) {
      console.warn(`⚠️  DuckDB replication failed for ${collection}:`, error.message);
    }
    
    return results;
  }

// Create singleton instance
const intelligentDB = new IntelligentDatabaseProxy();

// Export connection function
export async function connectToDb() {
  const isConnected = await intelligentDB.authenticate();
  if (!isConnected) {
    console.warn('⚠️  Intelligent DB not available - using fallback mode');
  }
  return intelligentDB;
}

// Export getIntelligentDB for compatibility
export async function getIntelligentDB() {
  return await connectToDb();
}

// Export default
export default intelligentDB;
