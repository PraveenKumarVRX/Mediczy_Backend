// =============================================================================
// Mediczy Prisma Schema — Enterprise SaaS Healthcare Platform
// =============================================================================
// Single source of truth for all 73 models.
// Replaces the dual-system (73 Sequelize JS files + SQL migrations).
//
// Run:  npx prisma migrate dev --name <description>
//       npx prisma generate
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "multiSchema"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto, pgvector(map: "vector")]
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum OrgType {
  hospital
  clinic
  corporate
  lab
  pharmacy
  individual
  insurance_broker
  tpa
  ngo
  psu
  homecare
  ambulance
}

enum UserStatus {
  active
  inactive
  suspended
  deleted
}
enum Gender {
  Male
  Female
  Other
}
enum ConsultationType {
  video
  audio
  chat
  in_person
}
enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
  rescheduled
}
enum ClaimStatus {
  submitted
  under_review
  approved
  rejected
  settled
}

// ─── PLATFORM (Control Plane) ─────────────────────────────────────────────────

model PlatformTenant {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantCode          String   @unique @map("tenant_code") @db.VarChar(20)
  tenantName          String   @map("tenant_name")
  tenantType          String   @map("tenant_type") @db.VarChar(50)
  dbStrategy          String   @default("SHARED") @map("db_strategy") @db.VarChar(20)
  dbHost              String?  @map("db_host")
  dbName              String?  @map("db_name") @db.VarChar(100)
  primaryDomain       String?  @map("primary_domain")
  customDomain        String?  @map("custom_domain")
  logoUrl             String?  @map("logo_url")
  themeConfig         Json     @default("{}") @map("theme_config")
  contactEmail        String   @map("contact_email")
  contactPhone        String?  @map("contact_phone") @db.VarChar(20)
  address             Json     @default("{}")
  countryCode         String   @default("IND") @map("country_code") @db.VarChar(3)
  timezone            String   @default("Asia/Kolkata")
  subscriptionPlan    String   @default("STARTER") @map("subscription_plan") @db.VarChar(50)
  subscriptionStatus  String   @default("TRIAL") @map("subscription_status") @db.VarChar(20)
  trialEndsAt         DateTime? @map("trial_ends_at")
  limits              Json     @default("{}")
  currentUsage        Json     @default("{}") @map("current_usage")
  status              String   @default("PENDING") @db.VarChar(20)
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("platform_tenants")
}

// ─── USER ─────────────────────────────────────────────────────────────────────

model User {
  id                    Int      @id @default(autoincrement())
  uuidId                String   @unique @default(uuid()) @map("uuid_id") @db.Uuid
  uniqueId              String?  @unique @map("unique_id") @db.VarChar(6)
  firstName             String   @db.VarChar(100)
  lastName              String   @db.VarChar(100)
  email                 String   @unique @db.VarChar(255)
  password              String   @db.VarChar(255)
  dateOfBirth           DateTime @map("date_of_birth")
  gender                Gender
  phoneNumber           String   @map("phone_number") @db.VarChar(20)
  organizationId        Int?     @map("organization_id")
  organizationType      OrgType? @default(individual) @map("organization_type")
  tenantId              Int?     @map("tenant_id")
  departmentId          Int?     @map("department_id")
  departmentName        String?  @map("department_name") @db.VarChar(100)
  role                  String   @default("user") @db.VarChar(50)
  isAdmin               Boolean  @default(false) @map("is_admin")
  addressStreet         String?  @map("address_street")
  addressCity           String?  @map("address_city") @db.VarChar(100)
  addressState          String?  @map("address_state") @db.VarChar(100)
  addressZipCode        String?  @map("address_zip_code") @db.VarChar(10)
  addressCountry        String?  @default("India") @map("address_country") @db.VarChar(100)
  addressJson           Json?    @default("{}") @map("address_json")
  bloodType             String?  @map("blood_type") @db.VarChar(10)
  height                Decimal? @db.Decimal(5, 1)
  weight                Decimal? @db.Decimal(5, 1)
  medicalHistory        Json     @default("{}") @map("medical_history")
  familyHistory         Json     @default("{}") @map("family_history")
  personalHistory       Json     @default("{}") @map("personal_history")
  profileImage          String?  @map("profile_image") @db.VarChar(500)
  abhaHealthId          String?  @unique @map("abha_health_id") @db.VarChar(50)
  isVerified            Boolean  @default(false) @map("is_verified")
  emailVerified         Boolean  @default(false) @map("email_verified")
  phoneVerified         Boolean  @default(false) @map("phone_verified")
  permissions           Json     @default("[]")
  scope                 Json     @default("{}")
  preferences           Json     @default("{}")
  metadata              Json     @default("{}")
  status                UserStatus @default(active)
  lastLoginAt           DateTime? @map("last_login_at")
  lastActivityAt        DateTime? @map("last_activity_at")
  loginCount            Int      @default(0) @map("login_count")
  corporateId           Int?     @map("corporate_id")
  employeeId            String?  @map("employee_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  appointments          Appointment[]   @relation("PatientAppointments")
  allergies             PatientAllergy[]
  medications           PatientMedication[]
  conditions            PatientCondition[]
  consents              PatientConsent[]
  vitalSigns            VitalSign[]
  familyMembers         FamilyMember[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([status])
  @@index([phoneNumber])
  @@map("users")
}

// ─── DOCTOR ───────────────────────────────────────────────────────────────────

model Doctor {
  id                Int      @id @default(autoincrement())
  uuidId            String   @unique @default(uuid()) @map("uuid_id") @db.Uuid
  userId            Int?     @map("user_id")
  firstName         String   @map("first_name") @db.VarChar(100)
  lastName          String   @map("last_name") @db.VarChar(100)
  email             String   @unique @db.VarChar(255)
  phoneNumber       String?  @map("phone_number") @db.VarChar(20)
  specialization    String?  @db.VarChar(100)
  organizationId    Int?     @map("organization_id")
  organizationType  OrgType? @map("organization_type")
  registrationNumber String? @map("registration_number") @db.VarChar(100)
  experience        Int?
  consultationFee   Decimal? @map("consultation_fee") @db.Decimal(10, 2)
  isOnline          Boolean  @default(false) @map("is_online")
  isAvailable       Boolean  @default(true) @map("is_available")
  rating            Decimal? @db.Decimal(3, 2)
  totalConsults     Int      @default(0) @map("total_consults")
  profileImage      String?  @map("profile_image") @db.VarChar(500)
  bio               String?  @db.Text
  availabilitySlots Json     @default("{}") @map("availability_slots")
  metadata          Json     @default("{}")
  status            String   @default("active") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  appointments      Appointment[]

  @@index([organizationId, isOnline])
  @@index([specialization])
  @@map("doctors")
}

// ─── APPOINTMENT ──────────────────────────────────────────────────────────────

model Appointment {
  id                  Int      @id @default(autoincrement())
  uuidId              String   @unique @default(uuid()) @map("uuid_id") @db.Uuid
  organizationId      Int?     @map("organization_id")
  organizationType    OrgType? @map("organization_type")
  tenantId            Int?     @map("tenant_id")
  corporateTenantId   Int?     @map("corporate_tenant_id")
  userId              Int?     @map("user_id")
  patientName         String   @map("patient_name") @db.VarChar(200)
  patientEmail        String?  @map("patient_email") @db.VarChar(255)
  patientPhone        String   @map("patient_phone") @db.VarChar(20)
  patientDetails      Json     @default("{}") @map("patient_details")
  doctorId            Int?     @map("doctor_id")
  doctorName          String   @map("doctor_name") @db.VarChar(200)
  specialization      String?  @db.VarChar(100)
  doctorDetails       Json     @default("{}") @map("doctor_details")
  appointmentDate     DateTime @map("appointment_date") @db.Date
  appointmentTime     String   @map("appointment_time") @db.VarChar(10)
  consultationType    ConsultationType @default(in_person) @map("consultation_type")
  status              AppointmentStatus @default(scheduled)
  notes               String?  @db.Text
  cancellationReason  String?  @map("cancellation_reason") @db.Text
  reminderSent        Boolean  @default(false) @map("reminder_sent")
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  patient             User?    @relation("PatientAppointments", fields: [userId], references: [id])
  doctor              Doctor?  @relation(fields: [doctorId], references: [id])

  @@index([organizationId, appointmentDate])
  @@index([tenantId])
  @@index([doctorId, appointmentDate, status])
  @@index([userId, appointmentDate])
  @@index([status, appointmentDate])
  @@map("appointments")
}

// ─── CLINICAL ─────────────────────────────────────────────────────────────────

model VitalSign {
  id              Int      @id @default(autoincrement())
  patientId       Int      @map("patient_id")
  organizationId  Int?     @map("organization_id")
  recordedBy      Int?     @map("recorded_by")
  bloodPressureSystolic  Int? @map("bp_systolic")
  bloodPressureDiastolic Int? @map("bp_diastolic")
  heartRate       Int?     @map("heart_rate")
  temperature     Decimal? @db.Decimal(4, 1)
  oxygenSaturation Int?   @map("oxygen_saturation")
  respiratoryRate Int?     @map("respiratory_rate")
  weight          Decimal? @db.Decimal(5, 1)
  height          Decimal? @db.Decimal(5, 1)
  bmi             Decimal? @db.Decimal(4, 1)
  bloodGlucose    Decimal? @map("blood_glucose") @db.Decimal(5, 1)
  notes           String?
  recordedAt      DateTime @default(now()) @map("recorded_at")
  createdAt       DateTime @default(now()) @map("created_at")

  patient         User     @relation(fields: [patientId], references: [id])

  @@index([patientId, recordedAt(sort: Desc)])
  @@index([organizationId])
  @@map("vital_signs")
}

model PatientAllergy {
  id              String   @id @default(uuid()) @db.Uuid
  userId          Int      @map("user_id")
  organizationId  Int?     @map("organization_id")
  allergenName    String   @map("allergen_name") @db.VarChar(200)
  allergenCode    String?  @map("allergen_code") @db.VarChar(50)
  allergenType    String?  @map("allergen_type") @db.VarChar(50)
  severity        String   @default("UNKNOWN") @db.VarChar(20)
  reactionType    String?  @map("reaction_type") @db.VarChar(200)
  verified        Boolean  @default(false)
  verifiedBy      Int?     @map("verified_by")
  source          String   @default("patient_reported") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([allergenCode])
  @@map("patient_allergies")
}

model PatientMedication {
  id              String   @id @default(uuid()) @db.Uuid
  userId          Int      @map("user_id")
  organizationId  Int?     @map("organization_id")
  drugName        String   @map("drug_name") @db.VarChar(200)
  drugCode        String?  @map("drug_code") @db.VarChar(50)
  genericName     String?  @map("generic_name") @db.VarChar(200)
  dose            String?  @db.VarChar(100)
  frequency       String?  @db.VarChar(100)
  status          String   @default("ACTIVE") @db.VarChar(20)
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  source          String   @default("patient_reported") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("patient_medications")
}

model PatientCondition {
  id              String   @id @default(uuid()) @db.Uuid
  userId          Int      @map("user_id")
  organizationId  Int?     @map("organization_id")
  conditionName   String   @map("condition_name") @db.VarChar(200)
  icd10Code       String?  @map("icd10_code") @db.VarChar(20)
  snomedCode      String?  @map("snomed_code") @db.VarChar(50)
  conditionType   String   @default("chronic") @map("condition_type") @db.VarChar(50)
  status          String   @default("ACTIVE") @db.VarChar(20)
  onsetDate       DateTime? @map("onset_date") @db.Date
  source          String   @default("patient_reported") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([icd10Code])
  @@map("patient_conditions")
}

// ─── CONSENT ──────────────────────────────────────────────────────────────────

model PatientConsent {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              Int?     @map("user_id")
  organizationId      Int?     @map("organization_id")
  consentType         String   @map("consent_type") @db.VarChar(80)
  consentCategory     String   @default("explicit") @map("consent_category") @db.VarChar(30)
  consented           Boolean
  consentedAt         DateTime? @map("consented_at")
  withdrawnAt         DateTime? @map("withdrawn_at")
  expiresAt           DateTime? @map("expires_at")
  policyVersion       String   @default("1.0") @map("policy_version") @db.VarChar(20)
  ipAddress           String?  @map("ip_address") @db.VarChar(45)
  consentMethod       String   @default("digital") @map("consent_method") @db.VarChar(50)
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  anonymousPatientId  String?  @map("anonymous_patient_id") @db.Uuid

  user                User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousPatient    AnonymousPatient? @relation(fields: [anonymousPatientId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@index([organizationId])
  @@map("patient_consents")
}

// ─── FAMILY MEMBER ────────────────────────────────────────────────────────────

model FamilyMember {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  firstName       String   @map("first_name") @db.VarChar(100)
  lastName        String   @map("last_name") @db.VarChar(100)
  relationship    String   @db.VarChar(50)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          Gender?
  phoneNumber     String?  @map("phone_number") @db.VarChar(20)
  isDependent     Boolean  @default(false) @map("is_dependent")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("family_members")
}

// ─── ORGANIZATION ENTITIES ────────────────────────────────────────────────────

model Hospital {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  email           String?  @unique @db.VarChar(255)
  phone           String?  @db.VarChar(20)
  address         Json     @default("{}")
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(100)
  country         String?  @default("India") @db.VarChar(100)
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  registrationNumber String? @map("registration_number") @db.VarChar(100)
  accreditations  Json     @default("[]")
  specialties     Json     @default("[]")
  totalBeds       Int?     @map("total_beds")
  isActive        Boolean  @default(true) @map("is_active")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([city, state])
  @@map("hospitals")
}

model Clinic {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  email           String?  @unique @db.VarChar(255)
  phone           String?  @db.VarChar(20)
  address         Json     @default("{}")
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(100)
  isActive        Boolean  @default(true) @map("is_active")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("clinics")
}

model Lab {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  email           String?  @unique @db.VarChar(255)
  phone           String?  @db.VarChar(20)
  address         Json     @default("{}")
  city            String?  @db.VarChar(100)
  nablAccredited  Boolean  @default(false) @map("nabl_accredited")
  homeCollection  Boolean  @default(false) @map("home_collection")
  isActive        Boolean  @default(true) @map("is_active")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  labTests        LabTest[]
  labOrders       LabOrder[]

  @@map("labs")
}

model LabTest {
  id              Int      @id @default(autoincrement())
  labId           Int      @map("lab_id")
  testName        String   @map("test_name") @db.VarChar(200)
  testCode        String?  @map("test_code") @db.VarChar(50)
  category        String?  @db.VarChar(100)
  price           Decimal  @db.Decimal(10, 2)
  turnaroundHours Int?     @map("turnaround_hours")
  requiresFasting Boolean  @default(false) @map("requires_fasting")
  sampleType      String?  @map("sample_type") @db.VarChar(100)
  isActive        Boolean  @default(true) @map("is_active")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  lab             Lab      @relation(fields: [labId], references: [id])

  @@index([labId, category])
  @@map("lab_tests")
}

model LabOrder {
  id              Int      @id @default(autoincrement())
  patientId       Int      @map("patient_id")
  labId           Int      @map("lab_id")
  doctorId        Int?     @map("doctor_id")
  organizationId  Int?     @map("organization_id")
  tests           Json     @default("[]")
  status          String   @default("pending") @db.VarChar(30)
  scheduledAt     DateTime? @map("scheduled_at")
  completedAt     DateTime? @map("completed_at")
  results         Json?
  reportUrl       String?  @map("report_url") @db.VarChar(500)
  totalAmount     Decimal? @map("total_amount") @db.Decimal(10, 2)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  lab             Lab      @relation(fields: [labId], references: [id])

  @@index([patientId, status])
  @@index([organizationId])
  @@map("lab_orders")
}

// ─── INSURANCE ────────────────────────────────────────────────────────────────

model InsurancePolicy {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  insurerName     String   @map("insurer_name") @db.VarChar(200)
  policyNumber    String   @map("policy_number") @db.VarChar(100)
  coverageType    String   @map("coverage_type") @db.VarChar(100)
  sumInsured      Decimal  @map("sum_insured") @db.Decimal(12, 2)
  premium         Decimal? @db.Decimal(10, 2)
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  isActive        Boolean  @default(true) @map("is_active")
  networkHospitals Json    @default("[]") @map("network_hospitals")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  claims          InsuranceClaim[]

  @@index([userId])
  @@index([policyNumber])
  @@map("insurance_policies")
}

model InsuranceClaim {
  id              Int      @id @default(autoincrement())
  policyId        Int      @map("policy_id")
  patientId       Int      @map("patient_id")
  organizationId  Int?     @map("organization_id")
  claimType       String   @map("claim_type") @db.VarChar(50)
  claimAmount     Decimal  @map("claim_amount") @db.Decimal(12, 2)
  approvedAmount  Decimal? @map("approved_amount") @db.Decimal(12, 2)
  status          ClaimStatus @default(submitted)
  diagnosisCode   String?  @map("diagnosis_code") @db.VarChar(20)
  documents       Json     @default("[]")
  submittedAt     DateTime @default(now()) @map("submitted_at")
  settledAt       DateTime? @map("settled_at")
  rejectionReason String?  @map("rejection_reason") @db.Text
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  policy          InsurancePolicy @relation(fields: [policyId], references: [id])

  @@index([patientId, status])
  @@index([organizationId])
  @@map("insurance_claims")
}

// ─── TENANT & ROLE ────────────────────────────────────────────────────────────

model Tenant {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  type            OrgType
  email           String   @unique @db.VarChar(255)
  phone           String?  @db.VarChar(20)
  address         Json     @default("{}")
  isActive        Boolean  @default(true) @map("is_active")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("tenants")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// ─── NOTIFICATION ─────────────────────────────────────────────────────────────

model Notification {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  organizationId  Int?     @map("organization_id")
  type            String   @db.VarChar(50)
  title           String   @db.VarChar(200)
  message         String   @db.Text
  channel         String   @db.VarChar(20)
  isRead          Boolean  @default(false) @map("is_read")
  readAt          DateTime? @map("read_at")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([organizationId])
  @@map("notifications")
}

// ─── HEALTH METRICS ───────────────────────────────────────────────────────────

model HealthReading {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  organizationId  Int?     @map("organization_id")
  readingType     String   @map("reading_type") @db.VarChar(50)
  value           Decimal  @db.Decimal(10, 2)
  unit            String   @db.VarChar(20)
  source          String   @default("manual") @db.VarChar(50)
  deviceId        String?  @map("device_id") @db.VarChar(100)
  recordedAt      DateTime @default(now()) @map("recorded_at")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, readingType, recordedAt(sort: Desc)])
  @@map("health_readings")
}

// ─── MEDICAL EMBEDDINGS (pgvector) ───────────────────────────────────────────

model MedicalEmbedding {
