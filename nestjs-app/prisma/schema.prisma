model UserAssociation {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("userId")
  entityType   String    @map("entityType") @db.VarChar(50)
  entityId     Int       @map("entityId")
  role         String    @db.VarChar(50)
  isPrimary    Boolean   @default(false) @map("isPrimary")
  status       String    @default("active") @db.VarChar(20)
  startDate    DateTime  @default(now()) @map("startDate")
  endDate      DateTime? @map("endDate")
  metadata     Json      @default("{}")
  permissions  Json      @default("{}")
  createdBy    Int?      @map("createdBy")
  notes        String?
  createdAt    DateTime  @default(now()) @map("createdAt")
  updatedAt    DateTime  @updatedAt @map("updatedAt")

  @@unique([userId, entityType, entityId, role], map: "unique_user_entity_role")
  @@index([userId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([isPrimary])
  @@map("user_associations")
}

model TeamMember {
  id               Int       @id @default(autoincrement())
  userId           Int?      @unique @map("userId")
  uniqueId         String?   @unique @map("unique_id") @db.VarChar(6)
  employeeId       String    @unique @db.VarChar(50)
  firstName        String    @db.VarChar(100)
  lastName         String    @db.VarChar(100)
  email            String    @unique @db.VarChar(255)
  password         String    @db.VarChar(255)
  phoneNumber      String    @db.VarChar(20)
  profileImage     String?   @db.VarChar(500)
  role             String    @default("support") @db.VarChar(30)
  department       String?   @db.VarChar(100)
  designation      String?   @db.VarChar(100)
  joiningDate      DateTime  @default(now())
  exitDate         DateTime?
  employmentStatus String    @default("active") @db.VarChar(20)
  employmentType   String    @default("full_time") @db.VarChar(20)
  permissions      Json      @default("{}")
  accessLevel      Int       @default(1) @map("accessLevel")
  workLocation     String?   @map("workLocation") @db.VarChar(255)
  emergencyContact Json      @default("{}") @map("emergencyContact")
  managerId        Int?      @map("managerId")
  metadata         Json      @default("{}")
  notes            String?
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false) @map("twoFactorEnabled")
  twoFactorSecret  String?   @map("twoFactorSecret") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("createdAt")
  updatedAt        DateTime  @updatedAt @map("updatedAt")

  @@index([role])
  @@index([employmentStatus])
  @@map("team_members")
}

