  deploymentSite       String?   @map("deployment_site") @db.VarChar(255)
  status               String    @default("inactive") @db.VarChar(20)
  batteryLevel         Int?      @map("battery_level")
  lastOnline           DateTime? @map("last_online")
  subscriptionPlan     String    @default("basic") @map("subscription_plan") @db.VarChar(20)
  subscriptionStart    DateTime? @map("subscription_start")
  subscriptionEnd      DateTime? @map("subscription_end")
  amcActive            Boolean   @default(true) @map("amc_active")
  amcStartDate         DateTime? @map("amc_start_date")
  amcEndDate           DateTime? @map("amc_end_date")
  amcRenewalDate       DateTime? @map("amc_renewal_date")
  deviceCost           Decimal   @default(0) @map("device_cost") @db.Decimal(10, 2)
  monthlySoftwareFee   Decimal   @default(0) @map("monthly_software_fee") @db.Decimal(10, 2)
  amcAnnualFee         Decimal   @default(0) @map("amc_annual_fee") @db.Decimal(10, 2)
  features             Json      @default("{}")
  lastMaintenance      DateTime? @map("last_maintenance")
  nextMaintenance      DateTime? @map("next_maintenance")
  warrantyExpiry       DateTime? @map("warranty_expiry")
  settings             Json      @default("{}")
  totalCallsMade       Int       @default(0) @map("total_calls_made")
  totalAppointments    Int       @default(0) @map("total_appointments")
  totalPrescriptions   Int       @default(0) @map("total_prescriptions")
  notes                String?
  metadata             Json      @default("{}")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([assignedToType, assignedToId])
  @@index([status])
  @@index([subscriptionPlan])
  @@index([amcActive])
  @@map("devices")
}

model CommunicationLog {
  id             String    @id @default(uuid()) @db.Uuid
  type           String    @db.VarChar(20)
  recipient      String    @db.VarChar(255)
  subject        String?   @db.VarChar(255)
  body           String
  status         String    @default("pending") @db.VarChar(20)
  createdBy      String    @map("createdBy") @db.Uuid
  organizationId String?   @map("organizationId") @db.Uuid
  metadata       Json      @default("{}")
  sentAt         DateTime? @map("sentAt")
  deliveredAt    DateTime? @map("deliveredAt")
  readAt         DateTime? @map("readAt")
  createdAt      DateTime  @default(now()) @map("createdAt")
  updatedAt      DateTime  @updatedAt @map("updatedAt")

  @@index([createdBy])
  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([recipient])
  @@map("communication_logs")
}

model ModuleAccess {
  id                    Int      @id @default(autoincrement())
  userType              String   @map("user_type") @db.VarChar(50)
  moduleId              String   @map("module_id") @db.VarChar(100)
  moduleName            String   @map("module_name") @db.VarChar(200)
  category              String?  @db.VarChar(100)
  isEnabled             Boolean  @default(true) @map("is_enabled")
  canView               Boolean  @default(true) @map("can_view")
  canCreate             Boolean  @default(false) @map("can_create")
  canEdit               Boolean  @default(false) @map("can_edit")
  canDelete             Boolean  @default(false) @map("can_delete")
  canExport             Boolean  @default(false) @map("can_export")
  additionalPermissions Json     @default("{}") @map("additional_permissions")
  displayOrder          Int      @default(0) @map("display_order")
  icon                  String?  @db.VarChar(50)
  routePath             String?  @map("route_path") @db.VarChar(200)
  modifiedBy            String?  @map("modified_by") @db.Uuid
