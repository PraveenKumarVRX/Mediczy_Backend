  hospitalId          Int?      @map("hospital_id")
  policyNumber        String    @map("policy_number") @db.VarChar(100)
  insuranceProviderId Int?      @map("insurance_provider_id")
  tpaId               Int?      @map("tpa_id")
  admissionDetails    Json      @map("admission_details")
  estimatedAmount     Decimal   @map("estimated_amount") @db.Decimal(10, 2)
  approvedAmount      Decimal?  @map("approved_amount") @db.Decimal(10, 2)
  diagnosis           String
