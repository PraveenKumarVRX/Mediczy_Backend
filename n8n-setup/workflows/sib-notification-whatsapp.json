{
  "name": "SIB: WhatsApp Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-notification",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-whatsapp",
      "name": "Webhook (WhatsApp Notification)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "sib-whatsapp-notification"
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "phoneNumber": "={{ $json.phone }}",
        "message": "={{ $json.message }}",
        "additionalFields": {
          "messageType": "={{ $json.message_type || 'text' }}"
        }
      },
      "id": "send-whatsapp",
      "name": "Send WhatsApp Message",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [450, 300],
      "credentials": {
        "whatsAppApi": {
          "id": "1",
          "name": "WhatsApp Business API"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO notification_logs (patient_id, channel, title, message, status, sent_at, metadata) VALUES ($1, $2, $3, $4, $5, NOW(), $6) RETURNING id",
        "additionalFields": {
          "queryParameters": "={{ JSON.stringify([$json.patient_id, 'whatsapp', $json.title, $json.message, $json.success ? 'sent' : 'failed', JSON.stringify({phone: $json.phone, execution_id: $json.execution_id})]) }}"
        }
      },
      "id": "log-whatsapp-db",
      "name": "Log to Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Mediczy"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({success: true, channel: 'whatsapp', phone: $json.phone, log_id: $json.id, timestamp: new Date().toISOString()}) }}"
      },
      "id": "respond-whatsapp",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook (WhatsApp Notification)": {
      "main": [
        [
          {
            "node": "Send WhatsApp Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp Message": {
      "main": [
        [
          {
            "node": "Log to Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Database": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "instanceId": "sib-whatsapp-workflow"
  },
  "tags": [
    {
      "name": "SIB",
      "id": "1"
    },
    {
      "name": "Notification",
      "id": "2"
    },
    {
      "name": "WhatsApp",
      "id": "3"
    }
  ]
}
