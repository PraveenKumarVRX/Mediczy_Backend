        "responseBody": "={{JSON.stringify({\n  success: true,\n  patient_id: $json.patient_id,\n  risk_level: $json.risk_level,\n  confidence_score: $json.confidence_score,\n  workflows_triggered: $json.workflows.length,\n  timestamp: $json.timestamp\n})}}",
        "options": {}
