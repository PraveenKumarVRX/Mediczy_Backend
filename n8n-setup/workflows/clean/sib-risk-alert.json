{
  "name": "SIB: High Risk Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "risk-alert",
        "options": {}
      },
      "name": "Webhook - Risk Alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "sib-risk-alert"
    },
    {
      "parameters": {
        "url": "http://localhost:8001/webhook/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow\": \"risk-alert\",\n  \"action\": \"trigger_notification\",\n  \"payload\": {\n    \"notification_data\": {\n      \"patient_id\": \"{{$node[\"Webhook - Risk Alert\"].json[\"data\"][\"patient_id\"]}}\",\n      \"title\": \"⚠️ High Risk Alert\",\n      \"message\": \"High cardiovascular risk detected. Risk score: {{$node[\"Webhook - Risk Alert\"].json[\"data\"][\"framingham_score\"]}}%. Please schedule a follow-up appointment.\",\n      \"type\": \"risk_alert\",\n      \"severity\": \"critical\",\n      \"channels\": [\"in_app\", \"push\", \"email\"]\n    }\n  }\n}",
        "options": {}
      },
      "name": "Notify Patient",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:3000/api/notifications/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"to\": \"care-team@mediczy.com\",\n  \"subject\": \"🚨 High Risk Patient Alert\",\n  \"body\": \"Patient ID: {{$node[\"Webhook - Risk Alert\"].json[\"data\"][\"patient_id\"]}}\\n\\nRisk Category: {{$node[\"Webhook - Risk Alert\"].json[\"data\"][\"risk_category\"]}}\\nFramingham Score: {{$node[\"Webhook - Risk Alert\"].json[\"data\"][\"framingham_score\"]}}%\\nASCVD Score: {{$node[\"Webhook - Risk Alert\"].json[\"data\"][\"ascvd_score\"]}}%\\n\\nRisk Factors:\\n{{JSON.stringify($node[\"Webhook - Risk Alert\"].json[\"data\"][\"risk_factors\"], null, 2)}}\\n\\nActions Required:\\n{{$node[\"Webhook - Risk Alert\"].json[\"data\"][\"actions_required\"].join('\\\\n')}}\",\n  \"priority\": \"high\"\n}",
        "options": {}
      },
      "name": "Notify Care Team",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:8001/webhook/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow\": \"risk-alert\",\n  \"action\": \"trigger_task\",\n  \"payload\": {\n    \"task_data\": {\n      \"title\": \"Follow-up required: High cardiovascular risk\",\n      \"description\": \"Patient {{$node[\"Webhook - Risk Alert\"].json[\"data\"][\"patient_id\"]}} has a Framingham score of {{$node[\"Webhook - Risk Alert\"].json[\"data\"][\"framingham_score\"]}}%. Schedule follow-up appointment within 7 days.\",\n      \"patient_id\": \"{{$node[\"Webhook - Risk Alert\"].json[\"data\"][\"patient_id\"]}}\",\n      \"task_type\": \"follow_up\",\n      \"priority\": \"urgent\",\n      \"due_date\": \"{{new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString()}}\"\n    }\n  }\n}",
        "options": {}
      },
      "name": "Create Follow-up Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        400
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:3000/api/analytics/risk-events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event_type\": \"high_risk_detected\",\n  \"patient_id\": \"{{$node[\"Webhook - Risk Alert\"].json[\"data\"][\"patient_id\"]}}\",\n  \"risk_data\": {{$node[\"Webhook - Risk Alert\"].json[\"data\"]}},\n  \"timestamp\": \"{{new Date().toISOString()}}\"\n}",
        "options": {}
      },
      "name": "Log to Analytics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        750,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "success"
            },
            {
              "name": "patient_notified",
              "value": "true"
            },
            {
              "name": "care_team_notified",
              "value": "true"
            },
            {
              "name": "follow_up_task_created",
              "value": "true"
            },
            {
              "name": "risk_category",
              "value": "={{$node[\"Webhook - Risk Alert\"].json[\"data\"][\"risk_category\"]}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        1000,
        300
      ]
    }
  ],
  "connections": {
    "Webhook - Risk Alert": {
      "main": [
        [
          {
            "node": "Notify Patient",
            "type": "main",
            "index": 0
          },
          {
            "node": "Notify Care Team",
            "type": "main",
            "index": 0
          },
          {
            "node": "Create Follow-up Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Patient": {
      "main": [
        [
          {
            "node": "Log to Analytics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Care Team": {
      "main": [
        [
          {
            "node": "Log to Analytics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Follow-up Task": {
      "main": [
        [
          {
            "node": "Log to Analytics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Analytics": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "instanceId": "mediczy-n8n"
  },
  "tags": [
