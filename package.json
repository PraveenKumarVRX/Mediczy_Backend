{
  "name": "vite-node-app",
  "version": "1.0.0",
  "description": "Vite + Node.js fullstack project",
  "scripts": {
    "dev": "concurrently \"npm run dev:watch --prefix server\" \"npm run dev:watch --prefix client\"",
    "dev:server": "npm run dev:watch --prefix server",
    "dev:client": "npm run dev:watch --prefix client",
    "start": "./scripts/development/dev-start.sh",
    "build": "npm run build --prefix client",
    "test:sanity-smoke:canonical": "bash ./scripts/testing/run-canonical-sanity-smoke.sh",
    "test:lab-flow-regression": "bash ./scripts/testing/lab-flow-regression.sh",
    "test:whatsapp-sib-auth-smoke": "npm run test:whatsapp-sib-auth-smoke --prefix server",
    "test:rag-refresh-audit": "npm run test:rag-refresh-audit --prefix server",
    "test:doctor-assistant-nav-regression": "npm run test:doctor-assistant-nav-regression --prefix server",
    "test:user-login-security-regression": "npm run test:user-login-security-regression --prefix server",
    "test:index-appointments-fallback-regression": "npm run e2e:index-appointments-fallback --prefix client",
    "ops:activate-subscription": "npm run ops:activate-subscription --prefix server --",
    "prepare": "[ -d .git ] && cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit || true"
  },
  "dependencies": {
    "@google/generative-ai": "^0.22.0",
    "@notifee/react-native": "^9.1.8",
    "@opentelemetry/api": "^1.9.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^23.8.5",
    "@react-native-firebase/messaging": "^23.8.5",
    "@xenova/transformers": "^2.17.2",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.78.1",
    "node-cron": "^4.2.1",
    "opossum": "^9.0.0",
    "redoc-express": "^2.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "xlsx-js-style": "^1.2.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@jest/globals": "^30.4.1",
    "@jridgewell/gen-mapping": "^0.1.1",
    "@jridgewell/sourcemap-codec": "^1.4.14",
    "@jridgewell/trace-mapping": "^0.3.18",
    "axios": "^1.13.2",
    "babel-jest": "^30.4.1",
    "colors": "^1.4.0",
    "concurrently": "^9.1.2",
    "dedent": "^1.5.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mysql2": "^3.16.2",
    "pg": "^8.18.0"
  },
  "main": "admin-auth-console-script.js",
  "keywords": [],
