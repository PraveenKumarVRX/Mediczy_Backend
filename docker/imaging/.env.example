# Copy to docker/imaging/.env and set real values. Never commit .env.
#
# If the password contains `$`, escape each as `$$` for Compose interpolation.
# Example: real password Um@$kr7168 → ORTHANC_PASSWORD=Um@$$kr7168
# server/.env should use the unescaped password: ORTHANC_PASSWORD=Um@$kr7168

ORTHANC_USER=pacs
ORTHANC_PASSWORD=replace-me-with-a-strong-secret
# Must match the password above (with the same $$ escaping if needed):
ORTHANC_REGISTERED_USERS={"pacs":"replace-me-with-a-strong-secret"}

ORTHANC_WEBHOOK_SECRET=
MEDICZY_API_URL=http://host.docker.internal:8888
POLL_INTERVAL_SEC=30
