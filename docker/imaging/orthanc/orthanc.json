{
  "Name": "MediczyPACS",
  "StorageDirectory": "/var/lib/orthanc/db",
  "IndexDirectory": "/var/lib/orthanc/db",
  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": true,
  "RegisteredUsers": {
    "pacs": "REPLACE_VIA_ENV_ORTHANC__REGISTERED_USERS"
  },
  "DicomAet": "MEDICZY",
  "DicomPort": 4242,
  "HttpPort": 8042,
  "StableAge": 10,
  "DicomWeb": {
    "Enable": true,
    "Root": "/dicom-web/",
    "EnableWado": true,
    "WadoRoot": "/wado",
    "Ssl": false
  }
}
