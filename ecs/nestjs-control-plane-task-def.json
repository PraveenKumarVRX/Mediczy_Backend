{
  "family": "mediczy-control-plane",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "REPLACE_WITH_ECS_EXECUTION_ROLE_ARN",
  "taskRoleArn": "REPLACE_WITH_ECS_TASK_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "mediczy-control-plane",
      "image": "REPLACE_WITH_ECR_IMAGE_URI",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        {
          "name": "ALLOWED_ORIGINS",
          "value": "https://mediczy.in,https://www.mediczy.in,https://app.mediqzy.com"
        }
      ],
      "secrets": [
        {
          "name": "POSTGRES_HOST",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/POSTGRES_HOST"
        },
        {
          "name": "POSTGRES_PORT",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/POSTGRES_PORT"
        },
        {
          "name": "POSTGRES_DATABASE",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/POSTGRES_DATABASE"
        },
        {
          "name": "POSTGRES_USER",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/POSTGRES_USER"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/POSTGRES_PASSWORD"
        },
        {
          "name": "POSTGRES_SSL",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/POSTGRES_SSL"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/JWT_SECRET"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mediczy-control-plane",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -q -O - http://localhost:3000/cp/live >/dev/null || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 45
      }
    }
  ]
}
