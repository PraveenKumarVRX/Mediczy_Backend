{
  "family": "mediczy-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::480664947830:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::480664947830:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "mediczy-worker",
      "image": "480664947830.dkr.ecr.ap-south-1.amazonaws.com/mediczy-app:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8889,
          "hostPort": 8889,
          "protocol": "tcp"
        }
      ],

      "environment": [],

      "secrets": [
        {
          "name": "POSTGRES_USER",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/POSTGRES_USER"
        },
        {
          "name": "POSTGRES_HOST",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/POSTGRES_HOST"
        },
        {
          "name": "POSTGRES_DATABASE",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/POSTGRES_DATABASE"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/POSTGRES_PASSWORD"
        },
        {
          "name": "POSTGRES_SSL",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/POSTGRES_SSL"
        },
        {
          "name": "REDIS_HOST",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/REDIS_HOST"
        },
        {
          "name": "REDIS_PORT",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/REDIS_PORT"
        },
        {
          "name": "REDIS_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/REDIS_PASSWORD"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/REDIS_URL"
        },
        {
          "name": "SIB_URL",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/SIB_URL"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-south-1:480664947830:parameter/mediczy/prod/JWT_SECRET"
        }
      ],

      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"require('http').get('http://localhost:8889/health', r => process.exit(r.statusCode === 200 ? 0 : 1))\" || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      },

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mediczy-worker",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },

      "mountPoints": [],
      "volumesFrom": [],
      "linuxParameters": {
        "initProcessEnabled": true
      }
    }
  ],
  "volumes": []
}
