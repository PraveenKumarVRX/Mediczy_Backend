              "path": ["{{tenant_id}}", "users", "{{user_id}}", "health-profile"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Search Doctors",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.doctors && response.doctors.length > 0) {",
                  "        pm.environment.set('doctor_id', response.doctors[0].doctor_id);",
                  "    }",
                  "    pm.test('Doctors retrieved successfully', () => {",
                  "        pm.expect(response.doctors).to.be.an('array');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/doctors?specialty=Cardiology&city=Mumbai&min_rating=4.0&limit=10",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "doctors"],
              "query": [
                {
                  "key": "specialty",
                  "value": "Cardiology"
                },
                {
                  "key": "city",
                  "value": "Mumbai"
                },
                {
                  "key": "min_rating",
                  "value": "4.0"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Doctor Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/doctors/{{doctor_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "doctors", "{{doctor_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Doctor Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/doctors/{{doctor_id}}/availability?start_date=2026-02-10&end_date=2026-02-17",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "doctors", "{{doctor_id}}", "availability"],
              "query": [
                {
                  "key": "start_date",
                  "value": "2026-02-10"
                },
                {
                  "key": "end_date",
                  "value": "2026-02-17"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/doctors/{{doctor_id}}/slots?date=2026-02-10&consultation_type=online",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "doctors", "{{doctor_id}}", "slots"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-02-10"
                },
                {
                  "key": "consultation_type",
                  "value": "online"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Create Appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('appointment_id', response.appointment_id);",
                  "    pm.test('Appointment created successfully', () => {",
                  "        pm.expect(response.appointment_id).to.exist;",
                  "        pm.expect(response.meeting_details.room_id).to.exist;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_id\": \"{{doctor_id}}\",\n  \"user_id\": \"{{user_id}}\",\n  \"appointment_date\": \"2026-02-10\",\n  \"appointment_time\": \"10:00\",\n  \"consultation_type\": \"online\",\n  \"reason\": \"Chest pain and breathing difficulty\",\n  \"symptoms\": [\n    \"Chest pain\",\n    \"Shortness of breath\",\n    \"Fatigue\"\n  ],\n  \"payment_method\": \"wallet\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/appointments",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "appointments"]
            }
          },
          "response": []
        },
        {
          "name": "List Appointments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/appointments?user_id={{user_id}}&status=pending&limit=20",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "appointments"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                },
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Appointment Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/appointments/{{appointment_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "appointments", "{{appointment_id}}"]
            }
          },
          "response": []
