              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_date\": \"2026-02-11\",\n  \"new_time\": \"14:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/appointments/{{appointment_id}}/reschedule",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "appointments", "{{appointment_id}}", "reschedule"]
            }
          },
          "response": []
