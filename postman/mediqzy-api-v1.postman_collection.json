            "header": [],
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/video/room/{{appointment_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "video", "room", "{{appointment_id}}"]
            }
          },
          "response": []
