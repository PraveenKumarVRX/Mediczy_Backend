              "raw": "{{base_url}}/{{tenant_id}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "users", "{{user_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+91-9999999999\",\n  \"address\": {\n    \"street\": \"456 New Street\",\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"postal_code\": \"400002\",\n    \"country\": \"India\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "users", "{{user_id}}"]
