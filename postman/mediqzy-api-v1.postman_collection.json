        {
          "name": "Complete Appointment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/appointments/{{appointment_id}}/complete",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "appointments", "{{appointment_id}}", "complete"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Video Consultation",
      "item": [
        {
          "name": "Generate Video Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.test('Video token generated successfully', () => {",
                  "        pm.expect(response.token).to.exist;",
                  "        pm.expect(response.room_id).to.exist;",
                  "        pm.expect(response.ws_url).to.exist;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointment_id\": \"{{appointment_id}}\",\n  \"participant_type\": \"patient\",\n  \"user_id\": \"{{user_id}}\",\n  \"name\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/video/token",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "video", "token"]
            }
          },
          "response": []
