        {
          "name": "Cancel Appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancellation_reason\": \"Emergency came up, need to reschedule\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/appointments/{{appointment_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "appointments", "{{appointment_id}}", "cancel"]
            }
          },
          "response": []
