              "raw": "{\n  \"duration_minutes\": 25,\n  \"recording_url\": \"https://storage.mediqzy.com/recordings/apt-12345.mp4\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/video/room/{{appointment_id}}/end",
              "host": ["{{base_url}}"],
              "path": ["{{tenant_id}}", "video", "room", "{{appointment_id}}", "end"]
            }
          },
          "response": []
        }
      ]
