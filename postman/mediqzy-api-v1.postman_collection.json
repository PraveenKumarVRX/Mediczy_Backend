              "path": ["{{tenant_id}}", "users", "{{user_id}}", "health-profile"]
            }
          },
          "response": []
        },
        {
          "name": "Update Health Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"height_cm\": 175,\n  \"weight_kg\": 70,\n  \"blood_type\": \"A+\",\n  \"allergies\": [\"Peanuts\", \"Penicillin\"],\n  \"chronic_conditions\": [\"Hypertension\"],\n  \"medications\": [\n    {\n      \"name\": \"Amlodipine\",\n      \"dosage\": \"5mg\",\n      \"frequency\": \"Once daily\"\n    }\n  ],\n  \"emergency_contact\": {\n    \"name\": \"Jane Doe\",\n    \"relationship\": \"Spouse\",\n    \"phone\": \"+91-9876543211\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{tenant_id}}/users/{{user_id}}/health-profile",
