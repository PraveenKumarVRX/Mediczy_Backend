{
  "info": {
    "name": "Mediczy Video Consultation API",
    "description": "Complete API collection for mobile app integration with video consultation features",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://mediczy.com/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctor_id",
      "value": "70",
      "type": "string"
    },
    {
      "key": "appointment_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('auth_token', jsonData.token);",
                  "    pm.environment.set('user_id', jsonData.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Mobile\",\n  \"lastName\": \"User\",\n  \"email\": \"mobile_{{$timestamp}}@example.com\",\n  \"password\": \"Test@123456\",\n  \"phoneNumber\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('auth_token', jsonData.token);",
                  "    pm.environment.set('user_id', jsonData.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test_patient@mediczy.com\",\n  \"password\": \"Test@123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/send-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+919876543210\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-otp"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Doctor Discovery",
      "item": [
        {
          "name": "List All Doctors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/consultation/doctors?limit=20&page=1&sortBy=rating",
              "host": ["{{base_url}}"],
              "path": ["consultation", "doctors"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "sortBy",
                  "value": "rating"
                }
              ]
            }
          }
        },
        {
          "name": "Search Doctors by Specialty",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/consultation/doctors?specialty=Cardiology&sortBy=rating",
              "host": ["{{base_url}}"],
              "path": ["consultation", "doctors"],
              "query": [
                {
                  "key": "specialty",
                  "value": "Cardiology"
                },
                {
                  "key": "sortBy",
                  "value": "rating"
                }
              ]
            }
          }
        },
        {
          "name": "Get Doctor Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/doctors/{{doctor_id}}",
              "host": ["{{base_url}}"],
              "path": ["doctors", "{{doctor_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Appointments",
      "item": [
        {
          "name": "Book Video Consultation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('appointment_id', jsonData.appointment.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": {{doctor_id}},\n  \"consultationType\": \"online\",\n  \"appointmentDate\": \"2026-01-28\",\n  \"appointmentTime\": \"10:00 AM\",\n  \"symptoms\": \"Chest pain and shortness of breath\",\n  \"urgency\": \"URGENT\",\n  \"paymentMethod\": \"wallet\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/consultation/book",
              "host": ["{{base_url}}"],
              "path": ["consultation", "book"]
            }
          }
        },
        {
          "name": "Get My Appointments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/appointments?status=confirmed&consultationType=online",
              "host": ["{{base_url}}"],
              "path": ["appointments"],
              "query": [
                {
                  "key": "status",
                  "value": "confirmed"
                },
                {
                  "key": "consultationType",
                  "value": "online"
                }
              ]
            }
          }
        },
        {
          "name": "Get Appointment Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/appointments/{{appointment_id}}",
              "host": ["{{base_url}}"],
              "path": ["appointments", "{{appointment_id}}"]
            }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Unable to attend\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/appointments/{{appointment_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["appointments", "{{appointment_id}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Video Consultation",
      "item": [
        {
          "name": "Get LiveKit Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomName\": \"apt-{{appointment_id}}\",\n  \"participantName\": \"Mobile User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/video/livekit/token",
              "host": ["{{base_url}}"],
              "path": ["video", "livekit", "token"]
            }
          }
        },
        {
          "name": "Join Video Room",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": {{appointment_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/video/room/apt-{{appointment_id}}/join",
              "host": ["{{base_url}}"],
              "path": ["video", "room", "apt-{{appointment_id}}", "join"]
            }
          }
        },
        {
          "name": "Get Room Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/video/room/apt-{{appointment_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["video", "room", "apt-{{appointment_id}}", "status"]
            }
          }
        },
        {
          "name": "Leave Video Room",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/video/room/apt-{{appointment_id}}/leave",
              "host": ["{{base_url}}"],
              "path": ["video", "room", "apt-{{appointment_id}}", "leave"]
            }
          }
        },
        {
          "name": "Test Video System",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/video/test",
              "host": ["{{base_url}}"],
              "path": ["video", "test"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Prescriptions",
      "item": [
        {
          "name": "Get Prescription by Appointment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prescriptions/appointment/{{appointment_id}}",
              "host": ["{{base_url}}"],
              "path": ["prescriptions", "appointment", "{{appointment_id}}"]
            }
          }
        },
        {
          "name": "Download Prescription PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prescriptions/{{prescription_id}}/pdf",
              "host": ["{{base_url}}"],
              "path": ["prescriptions", "{{prescription_id}}", "pdf"]
            }
          }
        },
        {
          "name": "Share Prescription via WhatsApp",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prescriptions/{{prescription_id}}/share/whatsapp/+919876543210",
              "host": ["{{base_url}}"],
              "path": ["prescriptions", "{{prescription_id}}", "share", "whatsapp", "+919876543210"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Wallet & Payments",
      "item": [
        {
          "name": "Get Wallet Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/wallet/balance",
              "host": ["{{base_url}}"],
              "path": ["wallet", "balance"]
            }
          }
        },
        {
          "name": "Calculate Consultation Cost",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/wallet/appointment/calculate/500",
              "host": ["{{base_url}}"],
              "path": ["wallet", "appointment", "calculate", "500"]
            }
          }
        },
        {
          "name": "Add Money to Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000,\n  \"paymentMethod\": \"razorpay\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/wallet/topup",
              "host": ["{{base_url}}"],
              "path": ["wallet", "topup"]
            }
          }
        },
        {
          "name": "Transaction History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/wallet/transactions?type=consultation&limit=20&page=1",
              "host": ["{{base_url}}"],
              "path": ["wallet", "transactions"],
              "query": [
                {
                  "key": "type",
                  "value": "consultation"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "7. User Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/profile",
              "host": ["{{base_url}}"],
              "path": ["users", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"dateOfBirth\": \"1990-01-01\",\n  \"gender\": \"Male\",\n  \"bloodType\": \"O+\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/profile",
              "host": ["{{base_url}}"],
              "path": ["users", "profile"]
            }
          }
        }
      ]
    }
  ]
}
