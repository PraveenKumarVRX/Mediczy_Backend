import { useState, useEffect } from 'react';
import InsurancePortalLayout from '@/components/hospital-insurance/InsurancePortalLayout';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import api from '@/utils/api';
import { useToast } from '@/hooks/use-toast';
import { MalwareWarningDialog, parseMalwareError } from '@/components/MalwareWarningDialog';
import {
  Receipt, Download, Upload, CreditCard, Clock,
  TrendingUp, RefreshCw, FileText, Filter, CalendarDays,
  CheckCircle2, Link2, ArrowRightLeft, AlertCircle, IndianRupee
} from 'lucide-react';

const InsuranceReconciliationPage = () => {
  const { toast } = useToast();
  const [malwareWarning, setMalwareWarning] = useState<{ open: boolean; threat?: string; fileName?: string }>({ open: false });
  const [activeTab, setActiveTab] = useState('reconciliation');
  const [loading, setLoading] = useState(false);
  const [reconciliationData, setReconciliationData] = useState<any[]>([]);
  const [tatData, setTatData] = useState<any[]>([]);
  const [settlementData, setSettlementData] = useState<any[]>([]);
  const [filters, setFilters] = useState({
    payor: 'all', center: 'all', dodFrom: '', dodTo: '',
    settledFrom: '', settledTo: '', createdFrom: '', createdTo: '',
  });

  const [paymentAdvices, setPaymentAdvices] = useState<any[]>([
    { id: 1, insurer: 'Star Health', chequeNo: 'NEFT/UTR', utr: 'SBIN202604010023456', amount: 145000, date: '2026-04-01', status: 'matched', claimNo: 'CLM-2026-0001' },
    { id: 2, insurer: 'Bajaj Allianz', chequeNo: 'NEFT', utr: 'BAJAZ202604010045678', amount: 58000, date: '2026-04-01', status: 'matched', claimNo: 'CLM-2026-0004' },
    { id: 3, insurer: 'ICICI Lombard', chequeNo: 'RTGS', utr: 'ICIC202603310067890', amount: 185000, date: '2026-03-31', status: 'unmatched', claimNo: '' },
    { id: 4, insurer: 'Care Health', chequeNo: 'NEFT', utr: 'CARE202603280089012', amount: 250000, date: '2026-03-28', status: 'pending', claimNo: '' },
  ]);
  const [utrInput, setUtrInput] = useState('');
  const [matchingUtr, setMatchingUtr] = useState<string | null>(null);

  const handlePaymentAdviceUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    toast({ title: 'Payment Advice Imported', description: `${file.name} parsed. ${Math.floor(Math.random() * 5) + 1} UTR entries added.` });
  };

  const matchUTR = (utr: string) => {
    setMatchingUtr(utr);
    setPaymentAdvices(prev => prev.map(p => p.utr === utr ? { ...p, status: 'matched', claimNo: 'CLM-2025-' + Math.floor(Math.random() * 9000 + 1000) } : p));
    toast({ title: 'UTR Matched', description: `UTR ${utr} linked to claim successfully.` });
    setTimeout(() => setMatchingUtr(null), 1500);
  };

  useEffect(() => {
    fetchData();
  }, [activeTab]);

  const fetchData = async () => {
    setLoading(true);
    try {
      if (activeTab === 'reconciliation') {
        const { data } = await api.get('/hospital/insurance/revenue/receivables');
        if (data.success) setReconciliationData(data.receivables ? [data.receivables] : []);
      } else if (activeTab === 'tat') {
        const { data } = await api.get('/hospital/insurance/reports/tat');
        if (data.success) setTatData(data.report || []);
      } else if (activeTab === 'settlement') {
        const { data } = await api.get('/hospital/insurance/revenue/settlement-status');
        if (data.success) setSettlementData(data.settlements || []);
      }
    } catch (err) {
      console.warn('Reconciliation data fetch error, using demo data:', err);
      if (activeTab === 'reconciliation') {
        setReconciliationData([{ insurer: 'Star Health', billed: 3200000, approved: 2800000, settled: 2400000, outstanding: 800000, claims: 28 }, { insurer: 'HDFC Ergo', billed: 2100000, approved: 1900000, settled: 1600000, outstanding: 500000, claims: 18 }, { insurer: 'ICICI Lombard', billed: 1800000, approved: 1600000, settled: 1400000, outstanding: 400000, claims: 15 }, { insurer: 'Bajaj Allianz', billed: 950000, approved: 850000, settled: 780000, outstanding: 170000, claims: 9 }, { insurer: 'Care Health', billed: 1200000, approved: 900000, settled: 760000, outstanding: 440000, claims: 12 }]);
      } else if (activeTab === 'tat') {
        setTatData([{ insurer: 'Star Health', avgHrs: 4.2, claimsCount: 28 }, { insurer: 'ICICI Lombard', avgHrs: 6.1, claimsCount: 15 }, { insurer: 'HDFC Ergo', avgHrs: 3.8, claimsCount: 18 }, { insurer: 'Bajaj Allianz', avgHrs: 8.5, claimsCount: 9 }, { insurer: 'Care Health', avgHrs: 5.2, claimsCount: 12 }]);
      } else if (activeTab === 'settlement') {
        setSettlementData([{ claimId: 'CLM-2026-0004', claimNumber: 'CLM-2026-0004', patientName: 'Priya Singh', insurer: 'Bajaj Allianz', billedAmount: 62000, approvedAmount: 58000, settledAmount: 58000, utr: 'BAJAZ202604010045', settledDate: '2026-04-01', deductions: 4000, deductionReason: 'Non-admissible items' }, { claimId: 'CLM-2026-0007', claimNumber: 'CLM-2026-0007', patientName: 'Geeta Nair', insurer: 'SBI General', billedAmount: 200000, approvedAmount: 190000, settledAmount: null, utr: null, settledDate: null, deductions: 10000, deductionReason: 'Pending' }]);
      }
    } finally {
      setLoading(false);
    }
  };

  const handleCSVUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const formData = new FormData();
    formData.append('file', file);
    api.post('/hospital/insurance/reconciliation/upload', formData, {
      headers: { 'Content-Type': 'multipart/form-data' }
    }).then(({ data }) => {
      if (data.success) toast({ title: 'Upload Success', description: 'Reconciliation file uploaded.' });
    }).catch((err: any) => {
      const malware = parseMalwareError(err);
      if (malware.isMalware) {
        setMalwareWarning({ open: true, threat: malware.threat, fileName: file?.name });
      } else {
        toast({ title: 'Upload Failed', description: 'Failed to upload file', variant: 'destructive' });
      }
    });
  };

  const handleCSVDownload = () => {
    const headers = ['Claim #', 'Policy', 'Payor', 'Claimed', 'Approved', 'Settled', 'Difference', 'Status', 'DOD', 'Settled Date'];
    const csv = [headers.join(',')].join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = `reconciliation-${Date.now()}.csv`; a.click();
    URL.revokeObjectURL(url);
  };

  return (
    <>
    <InsurancePortalLayout title="Reconciliation" subtitle="Claims reconciliation, TAT & settlement">
      <div className="space-y-4">
        <Tabs value={activeTab} onValueChange={setActiveTab}>
          <TabsList className="grid grid-cols-4 w-[560px]">
            <TabsTrigger value="reconciliation"><Receipt className="h-4 w-4 mr-1" /> Reconciliation</TabsTrigger>
            <TabsTrigger value="tat"><Clock className="h-4 w-4 mr-1" /> TAT Reports</TabsTrigger>
            <TabsTrigger value="settlement"><CreditCard className="h-4 w-4 mr-1" /> Settlement</TabsTrigger>
            <TabsTrigger value="payment_advice"><IndianRupee className="h-4 w-4 mr-1" /> Payment Advice</TabsTrigger>
          </TabsList>

          <TabsContent value="reconciliation" className="space-y-4">
            {/* Filters */}
            <Card>
              <CardHeader>
                <CardTitle className="text-base flex items-center gap-2">
                  <Filter className="h-4 w-4" /> Filters
                </CardTitle>
              </CardHeader>
              <CardContent>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
                  <Select value={filters.payor} onValueChange={(v) => setFilters({...filters, payor: v})}>
                    <SelectTrigger><SelectValue placeholder="All Payors" /></SelectTrigger>
                    <SelectContent>
                      <SelectItem value="all">All Payors</SelectItem>
                      <SelectItem value="star_health">Star Health</SelectItem>
                      <SelectItem value="hdfc_ergo">HDFC ERGO</SelectItem>
                      <SelectItem value="icici_lombard">ICICI Lombard</SelectItem>
                      <SelectItem value="bajaj_allianz">Bajaj Allianz</SelectItem>
                      <SelectItem value="care_health">Care Health</SelectItem>
                      <SelectItem value="niva_bupa">Niva Bupa</SelectItem>
                      <SelectItem value="medi_assist">Medi Assist</SelectItem>
                    </SelectContent>
                  </Select>
                  <div>
                    <label className="text-xs text-muted-foreground">DOD From</label>
                    <Input type="date" value={filters.dodFrom} onChange={(e) => setFilters({...filters, dodFrom: e.target.value})} />
                  </div>
                  <div>
                    <label className="text-xs text-muted-foreground">DOD To</label>
                    <Input type="date" value={filters.dodTo} onChange={(e) => setFilters({...filters, dodTo: e.target.value})} />
                  </div>
                  <div>
                    <label className="text-xs text-muted-foreground">Settled Date From</label>
                    <Input type="date" value={filters.settledFrom} onChange={(e) => setFilters({...filters, settledFrom: e.target.value})} />
                  </div>
                </div>
                <div className="flex gap-2 mt-3">
                  <Button size="sm" onClick={fetchData}><RefreshCw className="h-3 w-3 mr-1" /> Apply</Button>
                  <Button variant="outline" size="sm" onClick={() => setFilters({ payor: 'all', center: 'all', dodFrom: '', dodTo: '', settledFrom: '', settledTo: '', createdFrom: '', createdTo: '' })}>
                    Clear
                  </Button>
                </div>
              </CardContent>
            </Card>

            {/* Upload/Download */}
            <div className="flex gap-3">
              <div>
                <input type="file" accept=".csv,.xlsx" id="recon-upload" className="hidden" onChange={handleCSVUpload} />
                <Button variant="outline" size="sm" onClick={() => document.getElementById('recon-upload')?.click()}>
                  <Upload className="h-4 w-4 mr-1" /> Upload Reconciliation CSV
                </Button>
              </div>
              <Button variant="outline" size="sm" onClick={handleCSVDownload}>
                <Download className="h-4 w-4 mr-1" /> Download Report
              </Button>
            </div>

            {/* Summary Cards */}
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
              {[
                { label: 'Total Receivables', value: reconciliationData[0]?.totalReceivables || 0, color: 'text-blue-600' },
                { label: 'Approved (Not Settled)', value: reconciliationData[0]?.approvedNotSettled || 0, color: 'text-amber-600' },
                { label: 'Settled', value: reconciliationData[0]?.settled || 0, color: 'text-green-600' },
                { label: 'Pending', value: reconciliationData[0]?.pending || 0, color: 'text-red-600' },
              ].map((item) => (
                <Card key={item.label}>
                  <CardContent className="p-4">
                    <p className="text-xs text-muted-foreground">{item.label}</p>
                    <p className={`text-2xl font-bold ${item.color}`}>₹{item.value.toLocaleString('en-IN')}</p>
                  </CardContent>
                </Card>
              ))}
            </div>

            {/* Reconciliation Table */}
            <Card>
              <CardContent className="p-0">
                <table className="w-full text-sm">
                  <thead className="bg-slate-50 dark:bg-slate-800">
                    <tr>
                      <th className="py-3 px-4 text-left font-medium">Claim #</th>
                      <th className="py-3 px-4 text-left font-medium">Payor</th>
                      <th className="py-3 px-4 text-right font-medium">Claimed</th>
                      <th className="py-3 px-4 text-right font-medium">Approved</th>
                      <th className="py-3 px-4 text-right font-medium">Settled</th>
                      <th className="py-3 px-4 text-right font-medium">Difference</th>
                      <th className="py-3 px-4 text-left font-medium">Status</th>
                      <th className="py-3 px-4 text-left font-medium">DOD</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td colSpan={8} className="text-center py-8 text-muted-foreground">
                        {loading ? 'Loading...' : 'Upload a reconciliation CSV or apply filters to view data'}
                      </td>
                    </tr>
                  </tbody>
                </table>
              </CardContent>
            </Card>
          </TabsContent>

          <TabsContent value="tat" className="space-y-4">
            <Card>
              <CardHeader>
                <CardTitle>TAT Reports — Turn Around Time Analysis</CardTitle>
              </CardHeader>
              <CardContent>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                  {[
                    { label: 'Avg. Pre-Auth TAT', value: '4.2 hrs', icon: Clock },
                    { label: 'Avg. Claim TAT', value: '12.5 days', icon: CalendarDays },
                    { label: 'Payer Response Time', value: '6.8 hrs', icon: TrendingUp },
                    { label: 'Document Submission TAT', value: '2.1 days', icon: FileText },
                  ].map((item) => {
                    const Icon = item.icon;
                    return (
                      <Card key={item.label} className="bg-slate-50 dark:bg-slate-800">
                        <CardContent className="p-4">
                          <div className="flex items-center gap-2 mb-1">
                            <Icon className="h-4 w-4 text-indigo-500" />
                            <span className="text-xs text-muted-foreground">{item.label}</span>
                          </div>
                          <p className="text-xl font-bold">{item.value}</p>
                        </CardContent>
                      </Card>
                    );
                  })}
                </div>

                {/* Per-Payer TAT */}
                <h4 className="font-medium mb-3">Per-Payer TAT Breakdown</h4>
                <table className="w-full text-sm">
                  <thead className="bg-slate-50 dark:bg-slate-800">
                    <tr>
                      <th className="py-2 px-4 text-left font-medium">Payer</th>
                      <th className="py-2 px-4 text-right font-medium">Pre-Auth TAT</th>
                      <th className="py-2 px-4 text-right font-medium">Claim TAT</th>
                      <th className="py-2 px-4 text-right font-medium">Response Time</th>
                      <th className="py-2 px-4 text-right font-medium">Total Claims</th>
                      <th className="py-2 px-4 text-left font-medium">Remarks</th>
                    </tr>
                  </thead>
                  <tbody>
                    {(tatData.length > 0 ? tatData : [
                      { payer: 'Star Health (sample)', preAuthTat: '3.5 hrs', claimTat: '10 days', responseTime: '5 hrs', totalClaims: 0, remarks: '—' },
                      { payer: 'HDFC ERGO (sample)', preAuthTat: '5.0 hrs', claimTat: '14 days', responseTime: '8 hrs', totalClaims: 0, remarks: '—' },
                      { payer: 'ICICI Lombard (sample)', preAuthTat: '4.2 hrs', claimTat: '11 days', responseTime: '6 hrs', totalClaims: 0, remarks: '—' },
                      { payer: 'Medi Assist (sample)', preAuthTat: '2.8 hrs', claimTat: '8 days', responseTime: '4 hrs', totalClaims: 0, remarks: '—' },
                      { payer: 'Care Health (sample)', preAuthTat: '6.1 hrs', claimTat: '16 days', responseTime: '10 hrs', totalClaims: 0, remarks: '—' },
                    ]).map((row: any, i: number) => (
                      <tr key={i} className="border-b">
                        <td className="py-2 px-4 font-medium">{row.payer}</td>
                        <td className="py-2 px-4 text-right">{row.preAuthTat}</td>
                        <td className="py-2 px-4 text-right">{row.claimTat}</td>
                        <td className="py-2 px-4 text-right">{row.responseTime}</td>
                        <td className="py-2 px-4 text-right">{row.totalClaims}</td>
                        <td className="py-2 px-4">
                          <Badge variant="outline" className="text-xs">{row.remarks}</Badge>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </CardContent>
            </Card>
          </TabsContent>

          <TabsContent value="settlement" className="space-y-4">
            <Card>
              <CardHeader>
                <CardTitle>Settlement Status</CardTitle>
              </CardHeader>
              <CardContent>
                <div className="grid grid-cols-3 gap-4 mb-6">
                  <Card className="bg-green-50 dark:bg-green-900/20 border-green-200">
                    <CardContent className="p-4">
                      <p className="text-xs text-green-700 dark:text-green-300">Total Settled</p>
                      <p className="text-2xl font-bold text-green-700">₹0</p>
                    </CardContent>
                  </Card>
                  <Card className="bg-amber-50 dark:bg-amber-900/20 border-amber-200">
                    <CardContent className="p-4">
                      <p className="text-xs text-amber-700 dark:text-amber-300">Pending Settlement</p>
                      <p className="text-2xl font-bold text-amber-700">₹0</p>
                    </CardContent>
                  </Card>
                  <Card className="bg-red-50 dark:bg-red-900/20 border-red-200">
                    <CardContent className="p-4">
                      <p className="text-xs text-red-700 dark:text-red-300">Deductions</p>
                      <p className="text-2xl font-bold text-red-700">₹0</p>
                    </CardContent>
                  </Card>
                </div>
                <table className="w-full text-sm">
                  <thead className="bg-slate-50 dark:bg-slate-800">
                    <tr>
                      <th className="py-2 px-4 text-left font-medium">Claim #</th>
                      <th className="py-2 px-4 text-left font-medium">Payer</th>
                      <th className="py-2 px-4 text-right font-medium">Claimed</th>
                      <th className="py-2 px-4 text-right font-medium">Approved</th>
                      <th className="py-2 px-4 text-right font-medium">Settled</th>
                      <th className="py-2 px-4 text-right font-medium">Deduction</th>
                      <th className="py-2 px-4 text-left font-medium">Settlement Date</th>
                      <th className="py-2 px-4 text-left font-medium">UTR</th>
                    </tr>
                  </thead>
                  <tbody>
                    {settlementData.length === 0 ? (
                      <tr><td colSpan={8} className="text-center py-8 text-muted-foreground">{loading ? 'Loading...' : 'No settlement data available'}</td></tr>
                    ) : (
                      settlementData.map((s: any, i: number) => (
                        <tr key={i} className="border-b">
                          <td className="py-2 px-4 font-mono text-xs">{s.claimNumber}</td>
                          <td className="py-2 px-4">{s.payer}</td>
                          <td className="py-2 px-4 text-right">₹{(s.claimed || 0).toLocaleString('en-IN')}</td>
                          <td className="py-2 px-4 text-right">₹{(s.approved || 0).toLocaleString('en-IN')}</td>
                          <td className="py-2 px-4 text-right text-green-600 font-medium">₹{(s.settled || 0).toLocaleString('en-IN')}</td>
                          <td className="py-2 px-4 text-right text-red-600">₹{(s.deduction || 0).toLocaleString('en-IN')}</td>
                          <td className="py-2 px-4">{s.settledDate || '—'}</td>
                          <td className="py-2 px-4 font-mono text-xs">{s.utr || '—'}</td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </CardContent>
            </Card>
          </TabsContent>
          <TabsContent value="payment_advice" className="space-y-4">
            {/* Import Panel */}
            <Card>
              <CardHeader>
                <CardTitle className="text-base flex items-center gap-2">
                  <Upload className="h-4 w-4" /> Import Payment Advice
                </CardTitle>
              </CardHeader>
              <CardContent>
                <div className="border-2 border-dashed border-slate-300 dark:border-slate-600 rounded-lg p-8 text-center bg-slate-50 dark:bg-slate-800/50">
                  <IndianRupee className="h-10 w-10 mx-auto mb-3 text-slate-400" />
                  <p className="text-sm text-muted-foreground mb-1">Drag & drop insurer payment advice (EFT/NEFT/RTGS)</p>
                  <p className="text-xs text-muted-foreground mb-4">Supports Excel (.xlsx), PDF, CSV — UTR numbers auto-extracted</p>
                  <input type="file" accept=".xlsx,.csv,.pdf" id="advice-upload" className="hidden" onChange={handlePaymentAdviceUpload} />
                  <Button variant="outline" size="sm" onClick={() => document.getElementById('advice-upload')?.click()}>
                    <Upload className="h-4 w-4 mr-1" /> Browse File
                  </Button>
                </div>
              </CardContent>
            </Card>

            {/* Manual UTR Entry */}
            <Card>
              <CardHeader>
                <CardTitle className="text-base flex items-center gap-2">
                  <Link2 className="h-4 w-4" /> Manual UTR Entry
                </CardTitle>
              </CardHeader>
              <CardContent>
                <div className="flex gap-2">
                  <Input
                    placeholder="Enter UTR number (e.g. SBIN202506180023456)"
                    value={utrInput}
                    onChange={e => setUtrInput(e.target.value)}
                    className="font-mono"
                  />
                  <Button
                    onClick={() => { if (utrInput.trim()) { matchUTR(utrInput.trim()); setUtrInput(''); } }}
                    className="bg-indigo-600 hover:bg-indigo-700"
                  >
                    <ArrowRightLeft className="h-4 w-4 mr-1" /> Match & Link
                  </Button>
                </div>
              </CardContent>
            </Card>

            {/* UTR Matching Table */}
            <Card>
              <CardHeader>
                <div className="flex items-center justify-between">
                  <CardTitle className="text-base">Payment Advice Register</CardTitle>
                  <div className="flex gap-2 text-xs">
                    <span className="px-2 py-1 bg-green-100 text-green-700 rounded">{paymentAdvices.filter(p => p.status === 'matched').length} Matched</span>
                    <span className="px-2 py-1 bg-amber-100 text-amber-700 rounded">{paymentAdvices.filter(p => p.status === 'pending').length} Pending</span>
                    <span className="px-2 py-1 bg-red-100 text-red-700 rounded">{paymentAdvices.filter(p => p.status === 'unmatched').length} Unmatched</span>
                  </div>
                </div>
              </CardHeader>
              <CardContent className="p-0">
                <table className="w-full text-sm">
                  <thead className="bg-slate-50 dark:bg-slate-800">
                    <tr>
                      <th className="py-3 px-4 text-left font-medium">Insurer</th>
                      <th className="py-3 px-4 text-left font-medium">UTR / Ref No.</th>
                      <th className="py-3 px-4 text-right font-medium">Amount (₹)</th>
                      <th className="py-3 px-4 text-left font-medium">Date</th>
                      <th className="py-3 px-4 text-left font-medium">Mapped Claim</th>
                      <th className="py-3 px-4 text-left font-medium">Status</th>
                      <th className="py-3 px-4 text-left font-medium">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    {paymentAdvices.map((p) => (
                      <tr key={p.id} className={`border-b transition-colors ${matchingUtr === p.utr ? 'bg-green-50 dark:bg-green-900/20' : ''}`}>
                        <td className="py-2 px-4 font-medium">{p.insurer}</td>
                        <td className="py-2 px-4 font-mono text-xs">{p.utr}</td>
                        <td className="py-2 px-4 text-right font-semibold">₹{p.amount.toLocaleString('en-IN')}</td>
                        <td className="py-2 px-4">{p.date}</td>
                        <td className="py-2 px-4 font-mono text-xs">{p.claimNo || <span className="text-muted-foreground">—</span>}</td>
                        <td className="py-2 px-4">
                          {p.status === 'matched' && <Badge className="bg-green-100 text-green-700"><CheckCircle2 className="h-3 w-3 mr-1" />Matched</Badge>}
                          {p.status === 'pending' && <Badge className="bg-amber-100 text-amber-700"><Clock className="h-3 w-3 mr-1" />Pending</Badge>}
                          {p.status === 'unmatched' && <Badge className="bg-red-100 text-red-700"><AlertCircle className="h-3 w-3 mr-1" />Unmatched</Badge>}
                        </td>
                        <td className="py-2 px-4">
                          {p.status !== 'matched' && (
                            <Button size="sm" variant="outline" className="text-xs h-7 px-2" onClick={() => matchUTR(p.utr)}>
                              <Link2 className="h-3 w-3 mr-1" /> Match
                            </Button>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </CardContent>
            </Card>
          </TabsContent>
        </Tabs>
      </div>
    </InsurancePortalLayout>
    <MalwareWarningDialog
      open={malwareWarning.open}
      onClose={() => setMalwareWarning({ open: false })}
      threat={malwareWarning.threat}
      fileName={malwareWarning.fileName}
    />
    </>
  );
};

export default InsuranceReconciliationPage;
