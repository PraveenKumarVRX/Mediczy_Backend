{
  "name": "Mediczy - Membership Expiry",
  "nodes": [
    {
      "parameters": {
        "path": "membership-expiry",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "httpMethod": "POST"
      },
      "id": "membership-expiry-webhook",
      "name": "Membership Expiry Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        200
      ],
      "webhookId": "membership-expiry"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "patientId",
              "value": "={{$json[\"body\"][\"patientId\"]}}"
            },
            {
              "name": "patientName",
              "value": "={{$json[\"body\"][\"patientName\"]}}"
            },
            {
              "name": "patientEmail",
              "value": "={{$json[\"body\"][\"patientEmail\"]}}"
            },
            {
              "name": "planName",
              "value": "={{$json[\"body\"][\"planName\"]}}"
            },
            {
              "name": "expiresAt",
              "value": "={{$json[\"body\"][\"expiresAt\"]}}"
            },
            {
              "name": "daysUntilExpiry",
              "value": "={{$json[\"body\"][\"daysUntilExpiry\"]}}"
            },
            {
              "name": "renewalUrl",
              "value": "={{$json[\"body\"][\"renewalUrl\"] || '/membership'}}"
            },
            {
              "name": "emailSubject",
              "value": "=Your Mediczy Membership Expires in {{$json[\"body\"][\"daysUntilExpiry\"]}} Day(s)"
            },
            {
              "name": "emailBody",
              "value": "=Hi {{$json[\"body\"][\"patientName\"]}},\n\nYour Mediczy {{$json[\"body\"][\"planName\"]}} membership expires in {{$json[\"body\"][\"daysUntilExpiry\"]}} day(s) on {{$json[\"body\"][\"expiresAt\"]}}.\n\nRenew now to continue enjoying uninterrupted healthcare access.\n\nTeam Mediczy"
            },
            {
              "name": "whatsappBody",
              "value": "=📅 Heads up {{$json[\"body\"][\"patientName\"]}}: your Mediczy {{$json[\"body\"][\"planName\"]}} membership expires in {{$json[\"body\"][\"daysUntilExpiry\"]}} day(s). Renew now!"
            }
          ]
        }
      },
      "id": "prepare-membership-expiry",
      "name": "Prepare Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{$env.MEDICZY_BASE_URL}}/api/notifications/send-internal",
        "method": "POST",
        "sendBody": true,
        "options": {
          "timeout": 10000
        },
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({\n  \"userId\": $json.patientId,\n  \"type\": \"membership_expiring\",\n  \"channels\": [\"email\", \"whatsapp\", \"in-app\"],\n  \"subject\": $json.emailSubject,\n  \"body\": $json.emailBody,\n  \"whatsappBody\": $json.whatsappBody,\n  \"data\": { \"planName\": $json.planName, \"expiresAt\": $json.expiresAt, \"daysUntilExpiry\": $json.daysUntilExpiry },\n  \"actionUrl\": $json.renewalUrl\n}) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.MEDICZY_INTERNAL_TOKEN}}"
            }
          ]
        }
      },
      "id": "send-membership-expiry",
      "name": "Send Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        780,
        200
      ]
    }
  ],
  "connections": {
    "Membership Expiry Webhook": {
      "main": [
        [
          {
            "node": "Prepare Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Message": {
      "main": [
        [
          {
            "node": "Send Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
