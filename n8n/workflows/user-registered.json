{
  "name": "Mediczy - User Registered",
  "nodes": [
    {
      "parameters": {
        "path": "user-registered",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "httpMethod": "POST"
      },
      "id": "user-registered-webhook",
      "name": "User Registered Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        200
      ],
      "notes": "Trigger: POST /webhook/user-registered",
      "webhookId": "user-registered"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "userId",
              "value": "={{$json[\"body\"][\"userId\"]}}"
            },
            {
              "name": "userType",
              "value": "={{$json[\"body\"][\"userType\"] || 'patient'}}"
            },
            {
              "name": "userName",
              "value": "={{$json[\"body\"][\"name\"]}}"
            },
            {
              "name": "userEmail",
              "value": "={{$json[\"body\"][\"email\"]}}"
            },
            {
              "name": "whatsappBody",
              "value": "=Welcome to Mediczy, {{$json[\"body\"][\"name\"] || 'there'}}! Your account is ready. Start your health journey today."
            }
          ]
        }
      },
      "id": "prepare-message",
      "name": "Prepare Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        520,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{$env.MEDICZY_BASE_URL}}/api/notifications/send-internal",
        "method": "POST",
        "sendBody": true,
        "options": {
          "timeout": 10000
        },
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({\n  \"userId\": $json.userId,\n  \"userType\": $json.userType,\n  \"type\": \"welcome\",\n  \"channels\": [\"email\", \"whatsapp\", \"in-app\"],\n  \"subject\": \"Welcome to Mediczy!\",\n  \"body\": \"Hi \" + $json.userName + \", welcome to Mediczy! Your account is ready. Start booking appointments, tracking your health, and consulting our AI Doctor today.\",\n  \"whatsappBody\": $json.whatsappBody,\n  \"priority\": \"normal\",\n  \"data\": { \"userId\": $json.userId, \"userType\": $json.userType }\n}) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.MEDICZY_INTERNAL_TOKEN}}"
            }
          ]
        }
      },
      "id": "send-welcome",
      "name": "Send Welcome Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        800,
        200
      ]
    }
  ],
  "connections": {
    "User Registered Webhook": {
      "main": [
        [
          {
            "node": "Prepare Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Message": {
      "main": [
        [
          {
            "node": "Send Welcome Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
