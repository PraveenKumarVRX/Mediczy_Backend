{
  "name": "Mediczy - Health Report Ready",
  "nodes": [
    {
      "parameters": {
        "path": "health-report-ready",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "httpMethod": "POST"
      },
      "id": "health-report-webhook",
      "name": "Health Report Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        200
      ],
      "notes": "Trigger: POST /webhook/health-report-ready",
      "webhookId": "health-report-ready"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "patientId",
              "value": "={{$json[\"body\"][\"patientId\"]}}"
            },
            {
              "name": "patientName",
              "value": "={{$json[\"body\"][\"patientName\"]}}"
            },
            {
              "name": "reportId",
              "value": "={{$json[\"body\"][\"reportId\"]}}"
            },
            {
              "name": "bookingId",
              "value": "={{$json[\"body\"][\"bookingId\"]}}"
            },
            {
              "name": "reportUrl",
              "value": "={{$json[\"body\"][\"reportUrl\"]}}"
            }
          ]
        }
      },
      "id": "prepare-message",
      "name": "Prepare Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        520,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{$env.MEDICZY_BASE_URL}}/api/notifications/send-internal",
        "method": "POST",
        "sendBody": true,
        "options": {
          "timeout": 10000
        },
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({\n  \"userId\": $json.patientId,\n  \"userType\": \"patient\",\n  \"type\": \"health_report_ready\",\n  \"channels\": [\"email\", \"whatsapp\", \"in-app\"],\n  \"subject\": \"Your health report is ready\",\n  \"body\": \"Hi \" + $json.patientName + \", your health report is ready. View it here: \" + $json.reportUrl,\n  \"whatsappBody\": \"Hi \" + $json.patientName + \", your health report from Mediczy is ready. View it: \" + $json.reportUrl,\n  \"priority\": \"normal\",\n  \"data\": { \"reportId\": $json.reportId, \"reportUrl\": $json.reportUrl, \"bookingId\": $json.bookingId }\n}) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.MEDICZY_INTERNAL_TOKEN}}"
            }
          ]
        }
      },
      "id": "notify-patient-report",
      "name": "Notify Patient (Report Ready)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        800,
        200
      ]
    }
  ],
  "connections": {
    "Health Report Webhook": {
      "main": [
        [
          {
            "node": "Prepare Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Message": {
      "main": [
        [
          {
            "node": "Notify Patient (Report Ready)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
