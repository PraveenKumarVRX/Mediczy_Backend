{
  "name": "Mediczy - Daily KPI Summary",
  "nodes": [
    {
      "parameters": {
        "path": "daily-report",
        "method": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "daily-report-webhook",
      "name": "Daily Report Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "date",               "value": "={{$json[\"date\"]}}" },
            { "name": "totalAppointments",  "value": "={{$json[\"totalAppointments\"] ?? 0}}" },
            { "name": "completedAppointments", "value": "={{$json[\"completedAppointments\"] ?? 0}}" },
            { "name": "newPatients",        "value": "={{$json[\"newPatients\"] ?? 0}}" },
            { "name": "revenue",            "value": "={{$json[\"revenue\"] ?? 0}}" },
            { "name": "pendingPayments",    "value": "={{$json[\"pendingPayments\"] ?? 0}}" },
            { "name": "adminEmail",         "value": "={{$json[\"adminEmail\"] || 'admin@mediczy.com'}}" },
            {
              "name": "emailSubject",
              "value": "=Mediczy Daily KPI – {{$json[\"date\"]}}"
            },
            {
              "name": "emailBody",
              "value": "=📊 Daily KPI Report – {{$json[\"date\"]}}\n\n• Total Appointments: {{$json[\"totalAppointments\"]}}\n• Completed: {{$json[\"completedAppointments\"]}}\n• New Patients: {{$json[\"newPatients\"]}}\n• Revenue: ₹{{$json[\"revenue\"]}}\n• Pending Payments: {{$json[\"pendingPayments\"]}}\n\nGenerated by Mediczy Automation"
            }
          ]
        }
      },
      "id": "prepare-daily-report",
      "name": "Prepare Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [500, 200]
    },
    {
      "parameters": {
        "url": "={{$env.MEDICZY_BASE_URL}}/api/notifications/send-internal",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": { "timeout": 10000 },
        "bodyParametersJson": "={\n  \"adminEmail\": \"{{$json.adminEmail}}\",\n  \"type\": \"daily_kpi_report\",\n  \"channels\": [\"email\"],\n  \"subject\": \"{{$json.emailSubject}}\",\n  \"body\": \"{{$json.emailBody}}\",\n  \"data\": { \"date\": \"{{$json.date}}\", \"totalAppointments\": {{$json.totalAppointments}}, \"revenue\": {{$json.revenue}} }\n}",
        "headerParametersJson": "={ \"Authorization\": \"Bearer {{$env.MEDICZY_INTERNAL_TOKEN}}\" }"
      },
      "id": "send-daily-report",
      "name": "Send Report Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [780, 200]
    }
  ],
  "connections": {
    "Daily Report Webhook": {
      "main": [[{ "node": "Prepare Report", "type": "main", "index": 0 }]]
    },
    "Prepare Report": {
      "main": [[{ "node": "Send Report Email", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
