{
  "name": "Mediczy - Daily KPI Summary",
  "nodes": [
    {
      "parameters": {
        "path": "daily-report",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "httpMethod": "POST"
      },
      "id": "daily-report-webhook",
      "name": "Daily Report Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        200
      ],
      "webhookId": "daily-report"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "date",
              "value": "={{$json[\"body\"][\"date\"]}}"
            },
            {
              "name": "totalAppointments",
              "value": "={{$json[\"body\"][\"totalAppointments\"] ?? 0}}"
            },
            {
              "name": "completedAppointments",
              "value": "={{$json[\"body\"][\"completedAppointments\"] ?? 0}}"
            },
            {
              "name": "newPatients",
              "value": "={{$json[\"body\"][\"newPatients\"] ?? 0}}"
            },
            {
              "name": "revenue",
              "value": "={{$json[\"body\"][\"revenue\"] ?? 0}}"
            },
            {
              "name": "pendingPayments",
              "value": "={{$json[\"body\"][\"pendingPayments\"] ?? 0}}"
            },
            {
              "name": "adminEmail",
              "value": "={{$json[\"body\"][\"adminEmail\"] || 'admin@mediczy.com'}}"
            },
            {
              "name": "emailSubject",
              "value": "=Mediczy Daily KPI – {{$json[\"body\"][\"date\"]}}"
            },
            {
              "name": "emailBody",
              "value": "=📊 Daily KPI Report – {{$json[\"body\"][\"date\"]}}\n\n• Total Appointments: {{$json[\"body\"][\"totalAppointments\"]}}\n• Completed: {{$json[\"body\"][\"completedAppointments\"]}}\n• New Patients: {{$json[\"body\"][\"newPatients\"]}}\n• Revenue: ₹{{$json[\"body\"][\"revenue\"]}}\n• Pending Payments: {{$json[\"body\"][\"pendingPayments\"]}}\n\nGenerated by Mediczy Automation"
            }
          ]
        }
      },
      "id": "prepare-daily-report",
      "name": "Prepare Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{$env.MEDICZY_BASE_URL}}/api/notifications/send-internal",
        "method": "POST",
        "sendBody": true,
        "options": {
          "timeout": 10000
        },
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({\n  \"adminEmail\": $json.adminEmail,\n  \"type\": \"daily_kpi_report\",\n  \"channels\": [\"email\"],\n  \"subject\": $json.emailSubject,\n  \"body\": $json.emailBody,\n  \"data\": { \"date\": $json.date, \"totalAppointments\": $json.totalAppointments, \"revenue\": $json.revenue }\n}) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.MEDICZY_INTERNAL_TOKEN}}"
            }
          ]
        }
      },
      "id": "send-daily-report",
      "name": "Send Report Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        780,
        200
      ]
    }
  ],
  "connections": {
    "Daily Report Webhook": {
      "main": [
        [
          {
            "node": "Prepare Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Report": {
      "main": [
        [
          {
            "node": "Send Report Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
