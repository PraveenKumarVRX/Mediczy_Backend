{
  "name": "Mediczy - Appointment Reminder",
  "nodes": [
    {
      "parameters": {
        "path": "appointment-reminder",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "httpMethod": "POST"
      },
      "id": "appt-reminder-webhook",
      "name": "Appointment Reminder Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        200
      ],
      "webhookId": "appointment-reminder"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "patientName",
              "value": "={{$json[\"body\"][\"patientName\"]}}"
            },
            {
              "name": "doctorName",
              "value": "={{$json[\"body\"][\"doctorName\"]}}"
            },
            {
              "name": "appointmentDate",
              "value": "={{$json[\"body\"][\"appointmentDate\"]}}"
            },
            {
              "name": "appointmentTime",
              "value": "={{$json[\"body\"][\"appointmentTime\"]}}"
            },
            {
              "name": "consultationType",
              "value": "={{$json[\"body\"][\"consultationType\"]}}"
            },
            {
              "name": "reminderType",
              "value": "={{$json[\"body\"][\"reminderType\"]}}"
            },
            {
              "name": "patientId",
              "value": "={{$json[\"body\"][\"patientId\"]}}"
            },
            {
              "name": "appointmentId",
              "value": "={{$json[\"body\"][\"appointmentId\"]}}"
            },
            {
              "name": "emailSubject",
              "value": "=Appointment Reminder – {{$json[\"body\"][\"reminderType\"]}} notice"
            },
            {
              "name": "emailBody",
              "value": "=Hi {{$json[\"body\"][\"patientName\"]}},\n\nThis is a reminder for your appointment with Dr. {{$json[\"body\"][\"doctorName\"]}} on {{$json[\"body\"][\"appointmentDate\"]}} at {{$json[\"body\"][\"appointmentTime\"]}} ({{$json[\"body\"][\"consultationType\"]}}).\n\nPlease be on time.\n\nTeam Mediczy"
            },
            {
              "name": "whatsappBody",
              "value": "=Hi {{$json[\"body\"][\"patientName\"]}}, reminder: your appointment with Dr. {{$json[\"body\"][\"doctorName\"]}} is on {{$json[\"body\"][\"appointmentDate\"]}} at {{$json[\"body\"][\"appointmentTime\"]}}. Do not miss it!"
            }
          ]
        }
      },
      "id": "prepare-appt-reminder",
      "name": "Prepare Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{$env.MEDICZY_BASE_URL}}/api/notifications/send-internal",
        "method": "POST",
        "sendBody": true,
        "options": {
          "timeout": 10000
        },
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({\n  \"userId\": $json.patientId,\n  \"type\": \"appointment_reminder\",\n  \"channels\": [\"email\", \"whatsapp\", \"in-app\"],\n  \"subject\": $json.emailSubject,\n  \"body\": $json.emailBody,\n  \"whatsappBody\": $json.whatsappBody,\n  \"data\": { \"appointmentId\": $json.appointmentId, \"reminderType\": $json.reminderType }\n}) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.MEDICZY_INTERNAL_TOKEN}}"
            }
          ]
        }
      },
      "id": "send-appt-reminder",
      "name": "Send Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        780,
        200
      ]
    }
  ],
  "connections": {
    "Appointment Reminder Webhook": {
      "main": [
        [
          {
            "node": "Prepare Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Message": {
      "main": [
        [
          {
            "node": "Send Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
