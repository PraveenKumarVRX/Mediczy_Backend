{
  "name": "Mediczy - Doctor Performance Report",
  "nodes": [
    {
      "parameters": {
        "path": "doctor-performance",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "httpMethod": "POST"
      },
      "id": "doctor-perf-webhook",
      "name": "Doctor Performance Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        200
      ],
      "webhookId": "doctor-performance"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "doctorId",
              "value": "={{$json[\"body\"][\"doctorId\"]}}"
            },
            {
              "name": "doctorName",
              "value": "={{$json[\"body\"][\"doctorName\"]}}"
            },
            {
              "name": "doctorEmail",
              "value": "={{$json[\"body\"][\"doctorEmail\"]}}"
            },
            {
              "name": "weekStart",
              "value": "={{$json[\"body\"][\"weekStart\"]}}"
            },
            {
              "name": "weekEnd",
              "value": "={{$json[\"body\"][\"weekEnd\"]}}"
            },
            {
              "name": "consultationsCompleted",
              "value": "={{$json[\"body\"][\"consultationsCompleted\"]}}"
            },
            {
              "name": "revenue",
              "value": "={{$json[\"body\"][\"revenue\"]}}"
            },
            {
              "name": "avgRating",
              "value": "={{$json[\"body\"][\"avgRating\"]}}"
            },
            {
              "name": "emailSubject",
              "value": "=Weekly Performance Report – {{$json[\"body\"][\"weekStart\"]}} to {{$json[\"body\"][\"weekEnd\"]}}"
            },
            {
              "name": "emailBody",
              "value": "=Hi Dr. {{$json[\"body\"][\"doctorName\"]}},\n\nHere is your weekly performance summary:\n\nPeriod: {{$json[\"body\"][\"weekStart\"]}} – {{$json[\"body\"][\"weekEnd\"]}}\nConsultations Completed: {{$json[\"body\"][\"consultationsCompleted\"]}}\nRevenue Generated: ₹{{$json[\"body\"][\"revenue\"]}}\nAverage Rating: {{$json[\"body\"][\"avgRating\"]}}/5\n\nKeep up the great work!\n\nTeam Mediczy"
            }
          ]
        }
      },
      "id": "prepare-doctor-perf",
      "name": "Prepare Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{$env.MEDICZY_BASE_URL}}/api/notifications/send-internal",
        "method": "POST",
        "sendBody": true,
        "options": {
          "timeout": 10000
        },
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({\n  \"userId\": $json.doctorId,\n  \"userType\": \"doctor\",\n  \"type\": \"performance_report\",\n  \"channels\": [\"email\", \"in-app\"],\n  \"subject\": $json.emailSubject,\n  \"body\": $json.emailBody,\n  \"data\": { \"doctorId\": $json.doctorId, \"weekStart\": $json.weekStart, \"weekEnd\": $json.weekEnd }\n}) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.MEDICZY_INTERNAL_TOKEN}}"
            }
          ]
        }
      },
      "id": "send-doctor-perf",
      "name": "Send Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        780,
        200
      ]
    }
  ],
  "connections": {
    "Doctor Performance Webhook": {
      "main": [
        [
          {
            "node": "Prepare Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Message": {
      "main": [
        [
          {
            "node": "Send Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
