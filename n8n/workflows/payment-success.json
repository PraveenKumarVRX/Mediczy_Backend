{
  "name": "Mediczy - Payment Success",
  "nodes": [
    {
      "parameters": {
        "path": "payment-success",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "httpMethod": "POST"
      },
      "id": "pay-success-webhook",
      "name": "Payment Success Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        200
      ],
      "webhookId": "payment-success"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "patientId",
              "value": "={{$json[\"body\"][\"patientId\"]}}"
            },
            {
              "name": "patientName",
              "value": "={{$json[\"body\"][\"patientName\"]}}"
            },
            {
              "name": "invoiceId",
              "value": "={{$json[\"body\"][\"invoiceId\"]}}"
            },
            {
              "name": "amount",
              "value": "={{$json[\"body\"][\"amount\"]}}"
            },
            {
              "name": "transactionId",
              "value": "={{$json[\"body\"][\"transactionId\"]}}"
            },
            {
              "name": "emailSubject",
              "value": "Payment Received – Thank You!"
            },
            {
              "name": "emailBody",
              "value": "=Hi {{$json[\"body\"][\"patientName\"]}},\n\nWe have successfully received your payment of ₹{{$json[\"body\"][\"amount\"]}}.\n\nTransaction ID: {{$json[\"body\"][\"transactionId\"]}}\n\nThank you for using Mediczy!\n\nTeam Mediczy"
            }
          ]
        }
      },
      "id": "prepare-pay-success",
      "name": "Prepare Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{$env.MEDICZY_BASE_URL}}/api/notifications/send-internal",
        "method": "POST",
        "sendBody": true,
        "options": {
          "timeout": 10000
        },
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({\n  \"userId\": $json.patientId,\n  \"type\": \"payment_success\",\n  \"channels\": [\"email\", \"in-app\"],\n  \"subject\": $json.emailSubject,\n  \"body\": $json.emailBody,\n  \"data\": { \"invoiceId\": $json.invoiceId, \"amount\": $json.amount, \"transactionId\": $json.transactionId },\n  \"actionUrl\": \"/billing\"\n}) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.MEDICZY_INTERNAL_TOKEN}}"
            }
          ]
        }
      },
      "id": "send-pay-success",
      "name": "Send Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        780,
        200
      ]
    }
  ],
  "connections": {
    "Payment Success Webhook": {
      "main": [
        [
          {
            "node": "Prepare Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Message": {
      "main": [
        [
          {
            "node": "Send Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
